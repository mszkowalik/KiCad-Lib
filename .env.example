# Copy to .env and adjust. compose.yaml reads this automatically.
HTTPLIB_TOKEN=dev-token

# Jaravis (the library agent) activates when set.
#ANTHROPIC_API_KEY=

# Projects module ---------------------------------------------------------
# Encrypts stored git tokens at rest. CHANGE THIS before storing real tokens;
# changing it later makes previously stored tokens unreadable (re-enter them).
SECRET_KEY=dev-secret-change-me

# MinIO credentials (object storage for project snapshots, cached renders,
# production-run attachments). Console at http://localhost:9001.
MINIO_ROOT_USER=kicadlib
MINIO_ROOT_PASSWORD=kicadlib-secret

# Datasheets ---------------------------------------------------------------
# Address of this API as KiCad users see it: symbols link locally stored PDFs
# through it, so "localhost" only works for a single-machine setup.
#PUBLIC_BASE_URL=http://localhost:8020
# Nightly re-check of every datasheet source URL (conditional GETs — unchanged
# documents answer 304 and are not downloaded). Hour is server local time.
#DATASHEET_RECHECK_NIGHTLY=true
#DATASHEET_RECHECK_HOUR=3

# KiCad HTTP catalog geometry references (defaults match the PCM install:
# parts reference their base drawing in PCM_7Sigma_Base, footprints in
# PCM_7Sigma). Override only for CLI-sync setups with custom nicknames.
#HTTPLIB_SYMBOL_LIB=PCM_7Sigma_Base
#FOOTPRINT_LIB_NICKNAME=PCM_7Sigma

# JLCPCB OpenAPI — enables the private parts library (consigned stock) page
# and private-stock coverage in project stock checks. Apply for API access at
# https://api.jlcpcb.com, create an app, paste its credentials here.
#JLC_APP_ID=
#JLC_ACCESS_KEY=
#JLC_SECRET_KEY=
