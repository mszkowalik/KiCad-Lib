.venv/
__pycache__/
*.pyc
node_modules/
dist/
.env
data/
# ...but the field solver's material and stackup tables are SOURCE, not runtime
# data: they ship inside the package and the solver cannot start without them.
!api/app/services/fieldsolver/data/
!api/app/services/fieldsolver/data/*.json
render-cache/
.DS_Store
*.bak
*.egg-info/
# .claude/skills/ is TRACKED now. The documents used to be generated into it by
# a sync script driven by two hooks; they are ordinary files again, each stamped
# with the platform version it came from. Keeping them in git is what preserves
# Claude Code's skill discovery and auto-triggering — see the skills section of
# CLAUDE.md for how they are kept current.
# Supplier invoices: real PDFs with address/VAT/email — keep them out of git
jlcpcb_invoives/
# easyeda2kicad scratch output. Always download with --output ./easyeda_tmp so
# this one pattern covers it. Geometry that survives review is proposed to the
# platform, never committed from here.
easyeda_tmp.*
