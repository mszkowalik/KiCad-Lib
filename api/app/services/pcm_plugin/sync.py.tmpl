#!/usr/bin/env python3
"""7Sigma Library Sync — KiCad IPC action plugin entrypoint.

Toolbar button (PCB + schematic editors): fetches the platform's current PCM
library packages and refreshes the installed copies IN PLACE under the
3rd-party directory, incrementally (whole package skipped when its content
sha256 matches the last synced one). Only dependency: certifi (see
requirements.txt — KiCad's bundled Python has no CA store on macOS).

The 3rd-party root is derived from this file's own install location
(3rdparty/plugins/<id>/sync.py), so custom KiCad paths work automatically.

Local edits are never overwritten SILENTLY, and the unit of protection is the
DRAWING, not the file: a symbol you edited survives while the other 182 in the
same generated library still update, and an edit that has been pushed, approved
and has come back is adopted and stops counting as pending. Both tests compare a
canonical form of the s-expression — see kicad_canon.py.

Every local change the sync finds is ASKED about, in ONE window
(conflict_ui.py) with a Mine/Server choice per row, so the answer is given once
per sync rather than once per file. ONE ROW IS ONE ITEM — a symbol entry, a
footprint, a single 3D model — and never a whole library, in any path: a symbol
library the platform has stopped carrying is split per entry too, or "server"
would release 196 drawings on one click. Three kinds of row: an item changed
here AND on the platform (the real clash), an item changed only here (the
platform has nothing new to give — the choice exists so an edit can be
DISCARDED, which otherwise needed deleting the file by hand), and an item that
exists only here, where taking the platform's side deletes it. Declining to
choose — cancel, a closed window, no usable dialog backend — always keeps the
local copy, which is the behaviour this plugin had before the dialog existed.

3D models join that window as of plugin 1.3.0. They used to bypass it twice
over: the delta compared the upstream sha against the RECORDED sha, so a model
edited here read as current and was never re-fetched OR asked about, and the
full-zip fallback overwrote it without a word. `models_state.json` therefore
stores size and mtime beside each sha, and `_model_edits` stats the tree (fast)
and hashes only the files whose stat moved — 4745 models are about 1.4 GB, so
hashing all of them every sync was the reason the check did not exist.

Because of the second kind, a package with no upstream change is still fetched
while any local edit is outstanding. It is 0.5 MB, and it is the only way the
window can show what the platform would give back.

Every sync also SWEEPS the installed packages before it fetches anything. The
KiCad user directory is usually inside iCloud Drive, whose file provider
uniquifies a colliding folder name — a `7Sigma 2.pretty` appears beside
`7Sigma.pretty` when the PCM extracts over a copy iCloud still holds. It is
empty, yet the PCM registers every `*.pretty` in a package as a library, so
KiCad grows a second, broken footprint library. The sweep deletes such empty
folders and drops the dead rows they left in the global fp-lib-table /
sym-lib-table. It cannot live in the apply path: the install that creates a
stray also marks the package current, so apply is the one path that never runs
again.

Reopen the symbol chooser / footprint viewer after a sync — KiCad re-reads
changed library files; a KiCad restart is only needed after very large
changes, or after the sweep has edited a library table.
"""
from __future__ import annotations

import hashlib
import io
import json
import os
import re
import subprocess
import sys
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))  # KiCad runs this as a script; be explicit anyway
from kicad_canon import (  # noqa: E402 — needs the line above
    canon_hash, drop_symbols, matches, merge_symbol_lib, raw_hash, record,
    split_symbols,
)
import conflict_ui  # noqa: E402 — same reason

BASE_URL = "__BASE_URL__"
MANAGED_KINDS = ("symbols", "footprints", "3dmodels")
MODELS_ID = "com.sevensigma.models3d"
DELTA_MAX_FILES = 500  # larger deltas fall back to the full package zip
LIB_SUFFIXES = (".kicad_mod", ".kicad_sym")  # what this plugin tracks per file
PKG_DIR_PREFIX = "com_sevensigma"  # our install directories, under every kind
IGNORE_NAMES = (".DS_Store",)  # a folder holding only these is empty to us
# macOS uniquifies a colliding name as "<base> <n><ext>" ("7Sigma 2.pretty").
_DUP_NAME = re.compile(r"^(?P<base>.+) \d+(?P<ext>\.[^.]+)?$")
_LIB_ROW_URI = re.compile(r'^\s*\(lib .*\(uri "(?P<uri>[^"]*)"')
_3RD_PARTY_VAR = re.compile(r"\$\{[A-Za-z0-9_]*3RD_PARTY\}")
THIRD_PARTY = HERE.parents[1]  # .../3rdparty/plugins/<id>/ -> .../3rdparty
STATE_FILE = HERE / "sync_state.json"
MODELS_STATE_FILE = HERE / "models_state.json"  # relpath -> sha256 of installed models
LOCAL_STATE_FILE = HERE / "local_state.json"    # abspath -> sha256 of footprints WE wrote
LOCK_FILE = HERE / "sync.lock"
LOCK_STALE_S = 30 * 60  # a lock this old is a crash leftover — take it over

# Why a drawing is in the conflict window. Shown per row, because the answer
# depends on it: a two-way clash is a real arbitration, while "changed here
# only" is simply the user's own edit offered back for discarding.
BOTH = "changed here and on the platform"
MINE_ONLY = "changed here only"
NEW_HERE = "only here — never sent"


TOKEN = "__TOKEN__"          # baked in when installed from a personal repository URL
TOKEN_FILE = HERE / "token.json"
AGENT = "sevensigma-sync/1.0"


def _ssl_context():
    """A CA bundle KiCad's own Python can actually find.

    The bundled interpreter's compiled-in cafile path does not exist inside
    the macOS app bundle, so default verification fails on EVERY https URL
    (CERTIFICATE_VERIFY_FAILED, first seen when the platform moved to
    https://disfunction.cc). certifi comes from requirements.txt via the
    plugin venv; /etc/ssl/cert.pem is the macOS system bundle, kept for the
    case where the venv install was skipped. Returning None means stdlib
    defaults, which work on Linux system Pythons. NEVER disable verification
    here — the plugin carries a write credential.
    """
    import ssl
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except Exception:
        pass
    cafile = "/etc/ssl/cert.pem"
    try:
        if Path(cafile).exists():
            return ssl.create_default_context(cafile=cafile)
    except Exception:
        pass
    return None


_SSL_CTX = _ssl_context()


def _token() -> str:
    """The platform API token.

    Normally baked in at install time: a personal PCM repository URL
    (`…/repository.json?t=<token>`) serves a plugin zip with the token already
    in this file, so nobody types a credential.

    `token.json` beside this file is the manual fallback — the recovery path
    after a token rotation, when the installed copy still carries the old one.
    """
    global TOKEN
    if TOKEN:
        return TOKEN
    try:
        TOKEN = str(json.loads(TOKEN_FILE.read_text(encoding="utf-8")).get("token", ""))
    except Exception:
        TOKEN = ""
    return TOKEN


def _headers(extra: dict | None = None) -> dict:
    """Auth goes in a HEADER here, never the query string. Only PCM itself is
    forced to use `?t=`, and query strings land in the server access logs."""
    h = {"User-Agent": AGENT}
    token = _token()
    if token:
        h["Authorization"] = "Bearer " + token
    if extra:
        h.update(extra)
    return h


AUTH_HINT = (
    "The platform rejected this plugin's credentials.\n\n"
    "Fix it one of two ways:\n"
    "1. Reinstall the plugin from your personal repository URL "
    "(Setup page > KiCad), which bakes a fresh token in.\n"
    "2. Put {\"token\": \"7s_…\"} in token.json next to this plugin."
)


def _raise_friendly(err: Exception) -> None:
    """Turn a bare HTTP 401 into an instruction. Re-raises everything else."""
    if isinstance(err, urllib.error.HTTPError) and err.code in (401, 403):
        _notify(AUTH_HINT)
        raise SystemExit(AUTH_HINT)
    raise err


def _get(url: str, timeout: int = 600) -> bytes:
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read()
    except Exception as e:
        _raise_friendly(e)
        raise


def _post_json(url: str, payload: dict, timeout: int = 600) -> bytes:
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers=_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read()
    except Exception as e:
        _raise_friendly(e)
        raise


def _notify(message: str) -> None:
    print(message)
    if sys.platform == "darwin":
        try:
            # ensure_ascii=False: AppleScript chokes on \uXXXX escapes
            quoted = json.dumps(message, ensure_ascii=False)
            subprocess.run(
                ["osascript", "-e",
                 f'display notification {quoted} with title "7Sigma Library"'],
                check=False, timeout=10,
            )
        except Exception:
            pass


def _names(items, cap: int = 8) -> str:
    """A readable name list for a notification.

    Answers are per item now, so a single sync can touch hundreds of them and a
    full join turns a macOS notification into an unreadable wall (and is
    truncated by the OS anyway). The count carries the scale; the names carry
    the example.
    """
    uniq = sorted(set(items))
    if len(uniq) <= cap:
        return ", ".join(uniq)
    return ", ".join(uniq[:cap]) + f", and {len(uniq) - cap} more"


def _acquire_lock() -> bool:
    """One sync at a time — repeated button presses while a sync runs must
    not stack downloads. Atomic create; stale locks are taken over."""
    import os
    import time
    for _ in range(2):
        try:
            fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(fd)
            return True
        except FileExistsError:
            try:
                if time.time() - LOCK_FILE.stat().st_mtime > LOCK_STALE_S:
                    LOCK_FILE.unlink()
                    continue
            except OSError:
                pass
            return False
    return False


def _prune_empty_dirs(root: Path) -> list[Path]:
    """Delete the empty directories under `root`, deepest first.

    KiCad's PCM registers EVERY `*.pretty` it finds inside an installed
    package as a footprint library, and an empty one registers just as well as
    a full one. A folder holding nothing but `.DS_Store` counts as empty here —
    macOS writes that file into folders nobody asked it to keep.
    """
    gone: list[Path] = []
    for d in sorted((p for p in root.rglob("*") if p.is_dir()),
                    key=lambda p: len(p.parts), reverse=True):
        try:
            entries = list(d.iterdir())
            if any(f.name not in IGNORE_NAMES for f in entries):
                continue
            for f in entries:
                f.unlink()
            d.rmdir()
            gone.append(d)
        except OSError:
            pass  # busy, or gone already — the next sync tries again
    return gone


def _sweep_strays() -> tuple[list[str], list[str]]:
    """Clean the folders macOS invents inside our installed packages.

    The KiCad user directory is often inside iCloud Drive (`~/Documents`), and
    the file provider uniquifies a colliding directory name — the PCM extracts
    `7Sigma.pretty` over a copy iCloud still holds and a `7Sigma 2.pretty`
    appears beside it. It is empty, but the PCM registers it anyway, so KiCad
    grows a second, broken footprint library that nothing here ever wrote.

    Returns (deleted, left alone). This runs on EVERY sync, not only when a
    package is applied: a stray appears at INSTALL time, and the install that
    made it also told KiCad the package was current, so the apply path — where
    the prune used to live alone — is exactly the path that never runs again.
    A duplicate with files in it is reported, never deleted: this plugin cannot
    know whether those files are the user's.
    """
    deleted: list[str] = []
    kept: list[str] = []
    for kind in MANAGED_KINDS:
        base = THIRD_PARTY / kind
        if not base.is_dir():
            continue
        for pkg_root in sorted(base.glob(f"{PKG_DIR_PREFIX}*")):
            if not pkg_root.is_dir():
                continue
            deleted.extend(str(d.relative_to(THIRD_PARTY))
                           for d in _prune_empty_dirs(pkg_root))
            for d in pkg_root.iterdir():
                m = _DUP_NAME.match(d.name)
                if not d.is_dir() or not m:
                    continue
                original = pkg_root / (m.group("base") + (m.group("ext") or ""))
                if original.is_dir():
                    kept.append(str(d.relative_to(THIRD_PARTY)))
    return deleted, kept


def _kicad_config_dir() -> Path | None:
    """Where THIS KiCad keeps its global library tables.

    Derived from the install location rather than guessed: the plugin sits in
    `<user dir>/<version>/3rdparty/plugins/<id>/`, so the version is known, and
    only the platform's config root has to be filled in. `KICAD_CONFIG_HOME`
    wins when it is set, which is how a portable install moves the tables.
    """
    version = THIRD_PARTY.parent.name
    env = os.environ.get("KICAD_CONFIG_HOME")
    if env:
        root = Path(env)
    elif sys.platform == "darwin":
        root = Path.home() / "Library" / "Preferences" / "kicad"
    elif sys.platform.startswith("win"):
        root = Path(os.environ.get("APPDATA", Path.home() / "AppData" / "Roaming")) / "kicad"
    else:
        root = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "kicad"
    for candidate in (root / version, root):
        if (candidate / "fp-lib-table").exists() or (candidate / "sym-lib-table").exists():
            return candidate
    return None


def _repair_lib_tables() -> list[str]:
    """Drop library rows that point INSIDE our packages at a path that is gone.

    Deleting a stray folder is only half the repair: the PCM already wrote a
    row for it into the global table, and KiCad reports a missing library on
    every start until the row goes too. The test is deliberately narrow — a row
    is removed only when its URI resolves into one of our install directories
    AND that path does not exist — so a library of the user's own, or one from
    another package, is never touched.

    KiCad holds these tables in memory. A repair made while KiCad runs can be
    written back over on exit, which is why the notification asks for a
    restart.
    """
    config = _kicad_config_dir()
    if config is None:
        return []
    removed: list[str] = []
    for name in ("fp-lib-table", "sym-lib-table"):
        table = config / name
        try:
            lines = table.read_text(encoding="utf-8").splitlines(keepends=True)
        except OSError:
            continue
        keep: list[str] = []
        for line in lines:
            m = _LIB_ROW_URI.match(line)
            uri = m.group("uri") if m else ""
            resolved = _3RD_PARTY_VAR.sub(str(THIRD_PARTY), uri)
            ours = f"/{PKG_DIR_PREFIX}" in resolved and str(THIRD_PARTY) in resolved
            if ours and not Path(resolved).exists():
                removed.append(Path(resolved).name)
                continue
            keep.append(line)
        if len(keep) != len(lines):
            try:
                (config / f"{name}.bak").write_text("".join(lines), encoding="utf-8")
                table.write_text("".join(keep), encoding="utf-8")
            except OSError:
                pass
    return removed


# What this plugin last WROTE, keyed by absolute path (and by
# "<path>::<entry>" for the symbols inside one library file). A file whose
# content no longer matches its record was edited on this machine, so a sync
# must not simply overwrite it: that would destroy unsent work.
#
# Each record is {"r": raw sha256, "c": canonical sha256}; a bare string is the
# pre-1.1.0 file, which held the raw hash alone. The canonical hash is what
# makes the record survive a KiCad re-save — see kicad_canon.py for why a raw
# hash on its own reports 183 edited symbols after one edit.
_LOCAL: dict = {}


def _load_local_state() -> None:
    global _LOCAL
    if LOCAL_STATE_FILE.exists():
        try:
            _LOCAL = json.loads(LOCAL_STATE_FILE.read_text())
        except ValueError:
            _LOCAL = {}


def _save_local_state() -> None:
    LOCAL_STATE_FILE.write_text(json.dumps(_LOCAL, indent=0))


def _unchanged(key: str, data: bytes) -> bool:
    """True when `data` is still what this plugin wrote for `key`."""
    return matches(_LOCAL.get(key), data)


def _record_written(target: Path, payload: bytes, skip: set | None = None) -> None:
    """Baseline for the clobber check, and for what Push diffs against.

    Footprints are one file each, so the file is the unit. Symbols all live in
    ONE generated library, so the unit is an entry inside it — record those too
    or Push cannot tell which symbol you edited.

    `skip` names entries whose record must SURVIVE: after a merge the file on
    disk carries the user's unsent edit, and re-recording it would both let the
    next sync overwrite that edit and make Push forget it exists. The file-level
    record is left alone for the same reason.
    """
    if target.suffix == ".kicad_mod":
        _LOCAL[str(target)] = record(payload)
    elif target.suffix == ".kicad_sym":
        text = payload.decode("utf-8", "replace")
        entries = split_symbols(text)
        prefix = f"{target}::"
        live = {name for name, _ in entries}
        for key in [k for k in _LOCAL
                    if k.startswith(prefix) and k[len(prefix):] not in live]:
            del _LOCAL[key]  # the entry is gone from the library
        if not skip:
            _LOCAL[str(target)] = record(payload)
        for name, entry in entries:
            if skip and name in skip:
                continue
            _LOCAL[prefix + name] = record(entry)


def _conflicting_entries(target: Path, payload: bytes, current: bytes) -> list[tuple[str, str]]:
    """Names inside one symbol library that were edited here and differ from
    the platform's copy, each with why it is being asked about.

    Every base symbol lives in one generated file, so the whole-file rule
    "never overwrite an edited file" froze all 183 of them the moment one was
    edited — the unit has to be the entry.
    """
    up_text = payload.decode("utf-8", "replace")
    lo_text = current.decode("utf-8", "replace")
    upstream = dict(split_symbols(up_text))
    out: list[tuple[str, str]] = []
    for name, entry in split_symbols(lo_text):
        twin = upstream.get(name)
        if twin is not None and canon_hash(entry) == canon_hash(twin):
            continue  # same drawing either way — take the platform's copy
        if _unchanged(f"{target}::{name}", entry.encode("utf-8")):
            continue  # untouched here: upstream changed it, or removed it
        if twin is None:
            note = NEW_HERE
        elif _unchanged(f"{target}::{name}", twin.encode("utf-8")):
            note = MINE_ONLY  # the platform still has what we last wrote
        else:
            note = BOTH
        out.append((name, note))
    return out


def _merge_symbols(payload: bytes, current: bytes, keep: set[str]) -> bytes:
    """The platform's symbol library with `keep` replaced by the local copies.

    `keep` is what the user chose to hold on to; everything else takes the
    platform's drawing. An empty set means the whole upstream file wins.
    """
    if not keep:
        return payload
    return merge_symbol_lib(payload.decode("utf-8", "replace"),
                            current.decode("utf-8", "replace"), keep).encode("utf-8")


def _model_rel(dest: Path, f: Path) -> str:
    return f"3DModels/{f.relative_to(dest).as_posix()}"


def _model_record(f: Path, sha: str) -> dict:
    """State entry for a model file this plugin wrote: its sha plus the stat it
    had immediately after the write.

    `models_state.json` used to hold the bare sha, which was enough to decide
    WHAT to download but could never see a local edit: the comparison was
    upstream-sha against recorded-sha, so a model edited here still read as
    current and was silently clobbered on the next full sync. The stat is what
    makes the edit visible affordably — see `_model_edits`.
    """
    st = f.stat()
    return {"s": sha, "m": int(st.st_mtime), "z": st.st_size}


def _model_edits(dest: Path, local: dict) -> dict[str, str]:
    """{relpath: sha on disk} for every installed model that no longer holds
    what this plugin wrote. Upgrades pre-1.3.0 records in place.

    Stat first, hash only the suspects. The models tree is 4745 files and about
    1.4 GB, so hashing all of it on every sync is not affordable, and a file
    nothing touched still carries the size and mtime of the write. Any edit
    moves at least one of the two, and only then is the file read.

    A bare-string record is pre-1.3.0 and carries no stat to compare against.
    It adopts the current stat at the sha that record already asserted, so the
    upgrade reports no edits rather than a wave of false ones.
    """
    dirty: dict[str, str] = {}
    for f in dest.rglob("*"):
        if not f.is_file():
            continue
        rel = _model_rel(dest, f)
        rec = local.get(rel)
        if rec is None:
            continue  # never written by this plugin — the prune scan asks
        try:
            st = f.stat()
        except OSError:
            continue
        m, z = int(st.st_mtime), st.st_size
        if isinstance(rec, str):
            local[rel] = {"s": rec, "m": m, "z": z}
            continue
        if not isinstance(rec, dict):
            continue
        if rec.get("z") == z and rec.get("m") == m:
            continue  # untouched — the cheap answer, and the normal one
        disk = raw_hash(f.read_bytes())
        if disk == rec.get("s"):
            local[rel] = {"s": disk, "m": m, "z": z}  # re-stamped, same bytes
            continue
        dirty[rel] = disk
    return dirty


def _model_base(rec) -> str | None:
    if isinstance(rec, dict):
        return rec.get("s")
    return rec if isinstance(rec, str) else None


def _scan_models_delta(pkg: dict, state: dict) -> tuple[dict, list[dict]]:
    """Read-only pass over the models package: what the delta would fetch and
    prune, plus a conflict row for every model edited or drawn HERE.

    Returns (plan, conflicts). Raises to signal 'use the full package zip
    instead' (first install or huge delta). Nothing is written and nothing is
    asked, so the one dialog can carry model rows next to the library ones.
    """
    ident = pkg["identifier"]
    sha = pkg["versions"][0]["download_sha256"]
    dest = THIRD_PARTY / "3dmodels" / ident.replace(".", "_")
    if not dest.exists():
        raise RuntimeError("first install — full package needed")

    local: dict = {}
    if MODELS_STATE_FILE.exists():
        try:
            local = json.loads(MODELS_STATE_FILE.read_text())
        except ValueError:
            pass

    dirty = _model_edits(dest, local)
    if state.get(ident) == sha and not dirty:
        # Nothing changed either end. The record upgrade above may still have
        # rewritten entries, so the plan carries `local` back to be saved.
        return {"dest": dest, "sha": sha, "fresh": True, "local": local}, []

    manifest = json.loads(_get(f"{BASE_URL}/files/manifest.json", timeout=120))
    upstream = {e["path"]: e["sha256"] for e in manifest["files"]
                if e["path"].startswith("3DModels/")}

    need: list[str] = []
    asked: dict[str, str] = {}   # relpath -> dialog key
    conflicts: list[dict] = []
    for rel, up in upstream.items():
        f = dest / rel[len("3DModels/"):]
        if not f.is_file():
            need.append(rel)
            continue
        if rel in dirty:
            disk = dirty[rel]
            if disk == up:
                # the local edit IS the platform's copy now — it was pushed and
                # approved and has come back. Adopt it and stop asking.
                local[rel] = _model_record(f, disk)
                continue
            key = str(f)
            base = _model_base(local.get(rel))
            conflicts.append({"key": key, "kind": "model",
                              "name": f.relative_to(dest).as_posix(),
                              "note": BOTH if base != up else MINE_ONLY})
            asked[rel] = key
            need.append(rel)
            continue
        base = _model_base(local.get(rel))
        if base is None:
            # installed by the full package zip, before any record existed.
            # Seed it from disk, exactly as the bare-sha version did.
            local[rel] = _model_record(f, raw_hash(f.read_bytes()))
            base = local[rel]["s"]
        if base != up:
            need.append(rel)

    if len(need) > DELTA_MAX_FILES:
        raise RuntimeError("delta too large — full package needed")

    # models upstream no longer lists. One this plugin wrote and nothing touched
    # is a genuine upstream deletion and prunes silently, as before. Anything
    # else was put here by hand, so deleting it is the user's call.
    stale: list[Path] = []
    doomed: dict[str, Path] = {}
    for f in dest.rglob("*"):
        if not f.is_file():
            continue
        rel = _model_rel(dest, f)
        if rel in upstream:
            continue
        if local.get(rel) is not None and rel not in dirty:
            stale.append(f)
            continue
        key = str(f)
        conflicts.append({"key": key, "kind": "model",
                          "name": f.relative_to(dest).as_posix(),
                          "note": NEW_HERE, "delete": True})
        doomed[key] = f

    plan = {"dest": dest, "sha": sha, "local": local, "need": need,
            "asked": asked, "stale": stale, "doomed": doomed}
    return plan, conflicts


def _apply_models_delta(pkg: dict, state: dict, plan: dict,
                        decisions: dict[str, str]) -> str:
    """Write pass for the models package: fetch what the user did not keep,
    prune what upstream dropped, and delete only what the user agreed to."""
    ident = pkg["identifier"]
    dest, local = plan["dest"], plan["local"]

    if plan.get("fresh"):
        MODELS_STATE_FILE.write_text(json.dumps(local, indent=0))
        return "fresh"

    kept = {rel for rel, key in plan["asked"].items()
            if decisions.get(key) != conflict_ui.SERVER}
    need = [rel for rel in plan["need"] if rel not in kept]
    if kept:
        _notify("Kept your local 3D model(s) (not overwritten): "
                + _names(r[len("3DModels/"):] for r in kept)
                + ". Use 'Push 7Sigma changes' to send them.")

    if need:
        _notify(f"Downloading {len(need)} changed model file(s)…")
        data = _post_json(f"{BASE_URL}/api/kicad/pcm/models-delta", {"paths": need})
        zf = zipfile.ZipFile(io.BytesIO(data))
        for member in zf.infolist():
            if member.is_dir():
                continue
            rel = member.filename
            if not rel.startswith("3DModels/") or ".." in rel:
                continue
            target = dest / rel[len("3DModels/"):]
            target.parent.mkdir(parents=True, exist_ok=True)
            payload = zf.read(member)
            target.write_bytes(payload)
            local[rel] = _model_record(target, raw_hash(payload))

    removed, deleted = 0, []
    for f in plan["stale"]:
        f.unlink(missing_ok=True)
        removed += 1
    for key, f in plan["doomed"].items():
        if decisions.get(key) != conflict_ui.SERVER:
            continue
        f.unlink(missing_ok=True)
        removed += 1
        deleted.append(f.relative_to(dest).as_posix())
    if deleted:
        _notify("Deleted, as you chose (they exist nowhere else): "
                + _names(deleted))

    # An empty ".3dshapes" folder left by a prune otherwise lingers for ever and
    # KiCad still offers it in the 3D file browser.
    for d in sorted((p for p in dest.rglob("*") if p.is_dir()),
                    key=lambda p: len(p.parts), reverse=True):
        if not any(d.iterdir()):
            d.rmdir()

    # A record for a file no longer on disk is dead weight. Keying on the disk
    # rather than on `upstream` is what lets a model the user KEPT hold on to
    # its baseline, so the next sync can still tell it was edited here.
    local = {rel: rec for rel, rec in local.items()
             if (dest / rel[len("3DModels/"):]).is_file()}

    MODELS_STATE_FILE.write_text(json.dumps(local, indent=0))
    state[ident] = plan["sha"]
    STATE_FILE.write_text(json.dumps(state, indent=1))
    return "updated" if (need or removed) else "fresh"


def _members(zf: zipfile.ZipFile, dest_name: str):
    """The zip entries this plugin manages, as (kind, relpath, target).

    One definition shared by the conflict scan and the write pass — they must
    agree on which files are in play or the dialog would ask about a file the
    apply pass never touches.
    """
    for member in zf.infolist():
        if member.is_dir():
            continue
        parts = Path(member.filename).parts
        if len(parts) < 2 or parts[0] not in MANAGED_KINDS:
            continue
        kind, rel = parts[0], Path(*parts[1:])
        yield member, kind, rel, THIRD_PARTY / kind / dest_name / rel


def _has_local_edits(dest_name: str) -> bool:
    """True when any installed library file differs from what this plugin last
    wrote — an edit made here, or a drawing created here.

    This is what makes "drop my changes and take the platform's copy" possible.
    The package is skipped when its content sha matches the installed one, so
    with nothing changed upstream the sync used to end at "already up to date"
    and never mentioned the local edit at all: the only way to discard it was
    to delete the file by hand. When this returns True the package is fetched
    anyway, purely so the edit can be listed in the conflict window.

    Cheap in the normal case: `matches` compares the raw sha first, so an
    untouched tree costs one hash per file and never a canonical parse.
    """
    for kind in ("symbols", "footprints"):
        root = THIRD_PARTY / kind / dest_name
        if not root.is_dir():
            continue
        for f in root.rglob("*"):
            if f.is_file() and f.suffix in LIB_SUFFIXES and not _unchanged(str(f), f.read_bytes()):
                return True
    return False


def _fetch_package(pkg: dict, state: dict, force: bool = False) -> bytes | None:
    """The package zip, or None when the installed copy is already current.

    `force` fetches it regardless — see `_has_local_edits`.
    """
    ident = pkg["identifier"]
    dest_name = ident.replace(".", "_")  # KiCad's install-directory convention
    ver = pkg["versions"][0]
    sha = ver["download_sha256"]
    targets_exist = any((THIRD_PARTY / kind / dest_name).exists() for kind in MANAGED_KINDS)
    if state.get(ident) == sha and targets_exist and not force:
        return None
    if ver["download_size"] > 10 * 1024 * 1024:
        _notify(f"Downloading {pkg['name']} ({ver['download_size'] >> 20} MB)…")
    data = _get(ver["download_url"])
    if hashlib.sha256(data).hexdigest() != sha:
        raise RuntimeError(f"{pkg['name']}: download checksum mismatch")
    return data


def _scan_conflicts(pkg: dict, data: bytes) -> list[dict]:
    """Every local change the user could want to drop, for one package.

    Three kinds of row, all asked in the same window:
      * a drawing changed here AND on the platform — the genuine clash;
      * a drawing changed only here — nothing is at stake for the platform,
        but "take the platform's copy" is the only way to discard the edit
        short of deleting the file;
      * a library file that exists only here and was never pushed, where
        taking the platform's side means DELETING it.

    Read-only: nothing is written and no question is asked yet, so every
    package can be scanned before the single dialog goes up.
    """
    dest_name = pkg["identifier"].replace(".", "_")
    found: list[dict] = []
    zf = zipfile.ZipFile(io.BytesIO(data))
    upstream: dict[str, set] = {}
    for member, kind, rel, target in _members(zf, dest_name):
        upstream.setdefault(kind, set()).add(rel.as_posix())
        if target.suffix not in LIB_SUFFIXES or not target.is_file():
            continue
        current = target.read_bytes()
        if _unchanged(str(target), current):
            continue  # untouched here — upstream simply wins
        payload = zf.read(member)
        if canon_hash(current.decode("utf-8", "replace")) == \
                canon_hash(payload.decode("utf-8", "replace")):
            continue  # settled: the local edit IS the platform's copy now
        if target.suffix == ".kicad_sym":
            for name, note in _conflicting_entries(target, payload, current):
                found.append({"key": f"{target}::{name}", "kind": "symbol",
                              "name": name, "note": note})
        else:
            # The payload still matching our record means the platform has not
            # touched this drawing since we wrote it, so the only change is the
            # user's own.
            found.append({"key": str(target), "kind": "footprint",
                          "name": target.name,
                          "note": MINE_ONLY if _unchanged(str(target), payload) else BOTH})

    # files this package does not carry: drawn here and never pushed, or left
    # behind by a rename upstream. The prune deliberately keeps them, so this
    # window is the only place they can be cleared.
    for kind, keep in upstream.items():
        root = THIRD_PARTY / kind / dest_name
        if not root.is_dir():
            continue
        for f in root.rglob("*"):
            if not (f.is_file() and f.suffix in LIB_SUFFIXES
                    and f.relative_to(root).as_posix() not in keep):
                continue
            current = f.read_bytes()
            if _unchanged(str(f), current):
                continue
            if f.suffix == ".kicad_sym":
                # The unit is the ENTRY here too. A symbol library upstream no
                # longer carries used to be ONE row, tagged as a footprint, so
                # "server" threw away every drawing inside it on one click.
                for name, entry in split_symbols(
                        current.decode("utf-8", "replace")):
                    if _unchanged(f"{f}::{name}", entry.encode("utf-8")):
                        continue  # a stale copy of an upstream symbol, not work
                    found.append({"key": f"{f}::{name}", "kind": "symbol",
                                  "name": name, "note": NEW_HERE,
                                  "delete": True})
            else:
                found.append({"key": str(f), "kind": "footprint", "name": f.name,
                              "note": NEW_HERE, "delete": True})
    return found


def _apply_package(pkg: dict, state: dict, data: bytes,
                   decisions: dict[str, str]) -> str:
    """Install/refresh one library package. Returns 'updated' | 'fresh'."""
    ident = pkg["identifier"]
    dest_name = ident.replace(".", "_")
    sha = pkg["versions"][0]["download_sha256"]

    zf = zipfile.ZipFile(io.BytesIO(data))
    written: dict[str, set[str]] = {}
    kept_local: list[str] = []
    settled: list[str] = []
    overwritten: list[str] = []
    deleted: list[str] = []

    # The models package reaches this function only when the delta path gave up
    # (first install, or a delta past DELTA_MAX_FILES), so the per-model dialog
    # never ran. An edited model must still not be clobbered here: keep it, say
    # so, and let the next sync — a small delta by then — ask properly.
    models_state: dict = {}
    models_dirty: dict[str, str] = {}
    if ident == MODELS_ID:
        if MODELS_STATE_FILE.exists():
            try:
                models_state = json.loads(MODELS_STATE_FILE.read_text())
            except ValueError:
                models_state = {}
        models_root = THIRD_PARTY / "3dmodels" / dest_name
        if models_root.is_dir():
            models_dirty = _model_edits(models_root, models_state)

    for member, kind, rel, target in _members(zf, dest_name):
        written.setdefault(kind, set()).add(rel.as_posix())
        payload = zf.read(member)
        skip: set = set()
        # Library files only: reading a model here would pull 1.4 GB of STEP
        # through memory for a value the canonical test never uses. Models have
        # their own comparison, already done in `models_dirty` above.
        current = (target.read_bytes()
                   if target.suffix in LIB_SUFFIXES and target.is_file() else None)
        # NEVER clobber work edited here and not yet sent WITHOUT ASKING — that
        # is somebody's unsent drawing. The test is CURRENT FILE vs what we
        # recorded writing: comparing the incoming payload against the record
        # instead would mean "upstream changed, so keep the local copy", which
        # refuses every legitimate update — the exact opposite of the intent.
        # A 3D model has no canonical form to compare, so it is never parsed.
        if kind == "3dmodels" and models_dirty:
            mrel = f"3DModels/{rel.as_posix()}"
            if mrel in models_dirty:
                if decisions.get(str(target)) != conflict_ui.SERVER:
                    kept_local.append(rel.as_posix())
                    continue
                overwritten.append(rel.as_posix())
        if (target.suffix in LIB_SUFFIXES and current is not None
                and not _unchanged(str(target), current)):
            if canon_hash(current.decode("utf-8", "replace")) == \
                    canon_hash(payload.decode("utf-8", "replace")):
                # The local edit IS the platform's copy now: it was pushed and
                # approved and has come back, or KiCad merely re-saved the file
                # in its own spelling. Take the platform bytes and re-record —
                # without this the file stays "edited" for ever and Push keeps
                # offering to propose it again (reported 2026-08-20).
                settled.append(target.name)
            elif target.suffix == ".kicad_sym":
                # Only the entries the user chose to keep are held back; the
                # rest of the library updates as usual.
                keep = {n for n, _note in _conflicting_entries(target, payload, current)
                        if decisions.get(f"{target}::{n}") != conflict_ui.SERVER}
                payload = _merge_symbols(payload, current, keep)
                skip = keep
                kept_local.extend(f"{n} (symbol)" for n in sorted(keep))
            elif decisions.get(str(target)) == conflict_ui.SERVER:
                overwritten.append(target.name)  # user chose the platform copy
            else:
                kept_local.append(target.name)
                continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(payload)
        if kind == "3dmodels":
            models_state[f"3DModels/{rel.as_posix()}"] = _model_record(
                target, raw_hash(payload))
        else:
            _record_written(target, payload, skip)

    # prune files we manage that no longer exist upstream
    for kind, keep in written.items():
        root = THIRD_PARTY / kind / dest_name
        for f in root.rglob("*"):
            if f.is_file() and f.relative_to(root).as_posix() not in keep:
                # A library file this plugin did not write last is either a
                # local edit or a footprint drawn here that was never pushed.
                # Deleting it would destroy work that Push exists to send — so
                # it goes only when the user asked for it in the dialog.
                if kind == "3dmodels":
                    mrel = f"3DModels/{f.relative_to(root).as_posix()}"
                    if models_state.get(mrel) is None or mrel in models_dirty:
                        # placed here by hand, or edited here: the same rule the
                        # library files get, for the same reason
                        if decisions.get(str(f)) != conflict_ui.SERVER:
                            kept_local.append(f.relative_to(root).as_posix())
                            continue
                        deleted.append(f.relative_to(root).as_posix())
                    models_state.pop(mrel, None)
                elif f.suffix in LIB_SUFFIXES:
                    current = f.read_bytes()
                    if not _unchanged(str(f), current):
                        if f.suffix == ".kicad_sym":
                            # Answered per entry, so the file cannot simply go:
                            # drop the symbols the user released and rewrite the
                            # rest back. It only disappears when nothing is left.
                            text = current.decode("utf-8", "replace")
                            entries = split_symbols(text)
                            drop, mine = set(), []
                            for n, e in entries:
                                if decisions.get(f"{f}::{n}") == conflict_ui.SERVER:
                                    drop.add(n)
                                elif not _unchanged(f"{f}::{n}", e.encode("utf-8")):
                                    # only the entries that HAD a row are the
                                    # user's work; the rest are stale copies of
                                    # upstream drawings and are not worth naming
                                    mine.append(n)
                            deleted.extend(f"{n} (symbol)" for n in sorted(drop))
                            kept_local.extend(f"{n} (symbol)" for n in sorted(mine))
                            for n in drop:
                                _LOCAL.pop(f"{f}::{n}", None)
                            if len(drop) < len(entries):
                                if drop:
                                    f.write_bytes(drop_symbols(text, drop).encode("utf-8"))
                                    # the file-level record described the text
                                    # before the drop; the kept entries keep
                                    # their own records, which is what Push reads
                                    _LOCAL.pop(str(f), None)
                                continue
                            _LOCAL.pop(str(f), None)
                        elif decisions.get(str(f)) != conflict_ui.SERVER:
                            kept_local.append(f.name)
                            continue
                        else:
                            deleted.append(f.name)
                f.unlink()
        # a folder emptied by the prune above otherwise lingers forever, and
        # KiCad registers every .pretty it finds as a library
        _prune_empty_dirs(root)
    _save_local_state()
    if kept_local:
        _notify("Kept your local edits (not overwritten): " + _names(kept_local)
                + ". Use 'Push 7Sigma changes' to send them.")
    if overwritten:
        _notify("Replaced with the platform version, as you chose: "
                + _names(overwritten))
    if deleted:
        _notify("Deleted, as you chose (they exist nowhere else): "
                + _names(deleted))
    if settled:
        _notify(f"{len(settled)} local edit(s) now match the platform and are no longer "
                "pending: " + _names(settled))

    state[ident] = sha
    STATE_FILE.write_text(json.dumps(state, indent=1))
    if ident == MODELS_ID:
        # The full zip just rewrote the tree, so the records built above ARE the
        # delta bookkeeping. Dropping the file (as this did before models carried
        # records) would leave the next sync unable to tell an edit from a write.
        models_state = {rel: rec for rel, rec in models_state.items()
                        if (THIRD_PARTY / "3dmodels" / dest_name
                            / rel[len("3DModels/"):]).is_file()}
        MODELS_STATE_FILE.write_text(json.dumps(models_state, indent=0))
    return "updated"


def main() -> int:
    if not _acquire_lock():
        _notify("A sync is already running — hold on, it will notify when done.")
        return 0
    try:
        _load_local_state()
        # Before anything is fetched, and whether or not a package turns out to
        # be stale: the folders macOS invents are what KiCad shows as extra,
        # broken libraries, and they appear at install time — see _sweep_strays.
        swept, left = _sweep_strays()
        dead_rows = _repair_lib_tables()
        if swept:
            _notify(f"Removed {len(swept)} empty library folder(s) macOS left "
                    "behind: " + _names(swept))
        if dead_rows:
            _notify(f"Removed {len(dead_rows)} library table entry(ies) pointing "
                    "at folders that are gone: " + _names(dead_rows)
                    + ". Restart KiCad to stop it reporting a missing library.")
        if left:
            _notify("Duplicate library folder(s) with files inside — check them "
                    "and delete them by hand: " + _names(left))
        _notify("Checking for 7Sigma library updates…")
        try:
            repo = json.loads(_get(f"{BASE_URL}/api/kicad/pcm/repository.json", timeout=120))
            packages = json.loads(_get(repo["packages"]["url"], timeout=120))["packages"]
        except Exception as e:
            _notify(f"Sync failed: cannot reach the platform — {e}")
            return 1

        state: dict = {}
        if STATE_FILE.exists():
            try:
                state = json.loads(STATE_FILE.read_text())
            except ValueError:
                pass

        updated, fresh, failed = [], [], []

        # Pass 1 — fetch what is stale and find every clash, WITHOUT writing.
        # The dialog has to be able to list conflicts from all packages at once,
        # so nothing may be applied until every package has been looked at.
        pending: list[tuple[dict, bytes]] = []
        models: tuple[dict, dict] | None = None
        conflicts: list[dict] = []
        for pkg in packages:
            if pkg.get("type") != "library":
                continue  # never self-update the plugin from inside itself
            try:
                if pkg["identifier"] == MODELS_ID:
                    # models: incremental per-file delta (LZMA) when possible.
                    # Scanned, not applied — a model edited here is a row in the
                    # same dialog as the symbols and footprints.
                    try:
                        plan, rows = _scan_models_delta(pkg, state)
                        models = (pkg, plan)
                        conflicts.extend(rows)
                        continue
                    except Exception:
                        pass  # fall back to the full package zip below
                # A package that changed nowhere is skipped — UNLESS something
                # here was edited, in which case it is fetched purely so the
                # edit can be offered for discarding (see _has_local_edits).
                data = _fetch_package(
                    pkg, state,
                    force=_has_local_edits(pkg["identifier"].replace(".", "_")))
                if data is None:
                    fresh.append(pkg["name"])
                    continue
                pending.append((pkg, data))
                if pkg["identifier"] != MODELS_ID:
                    conflicts.extend(_scan_conflicts(pkg, data))
            except Exception as e:
                failed.append(f"{pkg['name']}: {e}")

        # One question for the whole sync.
        decisions: dict[str, str] = {}
        if conflicts:
            decisions, backend = conflict_ui.resolve(conflicts)
            if backend == "none":
                _notify(f"{len(conflicts)} local change(s) found but no dialog is "
                        "available here — kept your local copies. Use 'Push "
                        "7Sigma changes' to send them, or delete the file to "
                        "take the platform version.")
            elif backend == "too-many":
                _notify(f"{len(conflicts)} local changes — too many to review one "
                        "by one, so every local copy was kept. This usually means "
                        "the sync state was lost; Push what you want to keep, "
                        "then delete the local files and sync again.")

        # The dialog can sit open for a long time, and a lock older than
        # LOCK_STALE_S is treated as a crash leftover. Restart its clock so the
        # write pass does not begin already looking abandoned. (A sync started
        # while the dialog was open can still have taken the lock over; both
        # would write the same upstream bytes, so the cost is wasted work, not
        # a corrupt install.)
        if conflicts:
            LOCK_FILE.touch(exist_ok=True)

        # Pass 2 — write.
        if models is not None:
            pkg, plan = models
            try:
                result = _apply_models_delta(pkg, state, plan, decisions)
                (updated if result == "updated" else fresh).append(pkg["name"])
            except Exception as e:
                failed.append(f"{pkg['name']}: {e}")
        for pkg, data in pending:
            try:
                result = _apply_package(pkg, state, data, decisions)
                (updated if result == "updated" else fresh).append(pkg["name"])
            except Exception as e:
                failed.append(f"{pkg['name']}: {e}")

        if failed:
            _notify("Sync errors: " + "; ".join(failed))
            return 1
        if updated:
            _notify(f"Updated: {', '.join(updated)}. Reopen the symbol chooser to pick up changes.")
        else:
            _notify("Library already up to date.")
        return 0
    finally:
        LOCK_FILE.unlink(missing_ok=True)


if __name__ == "__main__":
    sys.exit(main())
