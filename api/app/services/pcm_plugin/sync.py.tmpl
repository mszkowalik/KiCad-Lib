#!/usr/bin/env python3
"""7Sigma Library Sync — KiCad IPC action plugin entrypoint.

Toolbar button (PCB + schematic editors): fetches the platform's current PCM
library packages and refreshes the installed copies IN PLACE under the
3rd-party directory, incrementally (whole package skipped when its content
sha256 matches the last synced one). Only dependency: certifi (see
requirements.txt — KiCad's bundled Python has no CA store on macOS).

The 3rd-party root is derived from this file's own install location
(3rdparty/plugins/<id>/sync.py), so custom KiCad paths work automatically.

Local edits are never overwritten, and the unit of protection is the DRAWING,
not the file: a symbol you edited survives while the other 182 in the same
generated library still update, and an edit that has been pushed, approved and
has come back is adopted and stops counting as pending. Both tests compare a
canonical form of the s-expression — see kicad_canon.py.

Reopen the symbol chooser / footprint viewer after a sync — KiCad re-reads
changed library files; a KiCad restart is only needed after very large
changes.
"""
from __future__ import annotations

import hashlib
import io
import json
import subprocess
import sys
import urllib.error
import urllib.request
import zipfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))  # KiCad runs this as a script; be explicit anyway
from kicad_canon import (  # noqa: E402 — needs the line above
    canon_hash, matches, merge_symbol_lib, record, split_symbols,
)

BASE_URL = "__BASE_URL__"
MANAGED_KINDS = ("symbols", "footprints", "3dmodels")
MODELS_ID = "com.sevensigma.models3d"
DELTA_MAX_FILES = 500  # larger deltas fall back to the full package zip
LIB_SUFFIXES = (".kicad_mod", ".kicad_sym")  # what this plugin tracks per file
THIRD_PARTY = HERE.parents[1]  # .../3rdparty/plugins/<id>/ -> .../3rdparty
STATE_FILE = HERE / "sync_state.json"
MODELS_STATE_FILE = HERE / "models_state.json"  # relpath -> sha256 of installed models
LOCAL_STATE_FILE = HERE / "local_state.json"    # abspath -> sha256 of footprints WE wrote
LOCK_FILE = HERE / "sync.lock"
LOCK_STALE_S = 30 * 60  # a lock this old is a crash leftover — take it over


TOKEN = "__TOKEN__"          # baked in when installed from a personal repository URL
TOKEN_FILE = HERE / "token.json"
AGENT = "sevensigma-sync/1.0"


def _ssl_context():
    """A CA bundle KiCad's own Python can actually find.

    The bundled interpreter's compiled-in cafile path does not exist inside
    the macOS app bundle, so default verification fails on EVERY https URL
    (CERTIFICATE_VERIFY_FAILED, first seen when the platform moved to
    https://disfunction.cc). certifi comes from requirements.txt via the
    plugin venv; /etc/ssl/cert.pem is the macOS system bundle, kept for the
    case where the venv install was skipped. Returning None means stdlib
    defaults, which work on Linux system Pythons. NEVER disable verification
    here — the plugin carries a write credential.
    """
    import ssl
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except Exception:
        pass
    cafile = "/etc/ssl/cert.pem"
    try:
        if Path(cafile).exists():
            return ssl.create_default_context(cafile=cafile)
    except Exception:
        pass
    return None


_SSL_CTX = _ssl_context()


def _token() -> str:
    """The platform API token.

    Normally baked in at install time: a personal PCM repository URL
    (`…/repository.json?t=<token>`) serves a plugin zip with the token already
    in this file, so nobody types a credential.

    `token.json` beside this file is the manual fallback — the recovery path
    after a token rotation, when the installed copy still carries the old one.
    """
    global TOKEN
    if TOKEN:
        return TOKEN
    try:
        TOKEN = str(json.loads(TOKEN_FILE.read_text(encoding="utf-8")).get("token", ""))
    except Exception:
        TOKEN = ""
    return TOKEN


def _headers(extra: dict | None = None) -> dict:
    """Auth goes in a HEADER here, never the query string. Only PCM itself is
    forced to use `?t=`, and query strings land in the server access logs."""
    h = {"User-Agent": AGENT}
    token = _token()
    if token:
        h["Authorization"] = "Bearer " + token
    if extra:
        h.update(extra)
    return h


AUTH_HINT = (
    "The platform rejected this plugin's credentials.\n\n"
    "Fix it one of two ways:\n"
    "1. Reinstall the plugin from your personal repository URL "
    "(Setup page > KiCad), which bakes a fresh token in.\n"
    "2. Put {\"token\": \"7s_…\"} in token.json next to this plugin."
)


def _raise_friendly(err: Exception) -> None:
    """Turn a bare HTTP 401 into an instruction. Re-raises everything else."""
    if isinstance(err, urllib.error.HTTPError) and err.code in (401, 403):
        _notify(AUTH_HINT)
        raise SystemExit(AUTH_HINT)
    raise err


def _get(url: str, timeout: int = 600) -> bytes:
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read()
    except Exception as e:
        _raise_friendly(e)
        raise


def _post_json(url: str, payload: dict, timeout: int = 600) -> bytes:
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers=_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read()
    except Exception as e:
        _raise_friendly(e)
        raise


def _notify(message: str) -> None:
    print(message)
    if sys.platform == "darwin":
        try:
            # ensure_ascii=False: AppleScript chokes on \uXXXX escapes
            quoted = json.dumps(message, ensure_ascii=False)
            subprocess.run(
                ["osascript", "-e",
                 f'display notification {quoted} with title "7Sigma Library"'],
                check=False, timeout=10,
            )
        except Exception:
            pass


def _acquire_lock() -> bool:
    """One sync at a time — repeated button presses while a sync runs must
    not stack downloads. Atomic create; stale locks are taken over."""
    import os
    import time
    for _ in range(2):
        try:
            fd = os.open(LOCK_FILE, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
            os.close(fd)
            return True
        except FileExistsError:
            try:
                if time.time() - LOCK_FILE.stat().st_mtime > LOCK_STALE_S:
                    LOCK_FILE.unlink()
                    continue
            except OSError:
                pass
            return False
    return False


# What this plugin last WROTE, keyed by absolute path (and by
# "<path>::<entry>" for the symbols inside one library file). A file whose
# content no longer matches its record was edited on this machine, so a sync
# must not simply overwrite it: that would destroy unsent work.
#
# Each record is {"r": raw sha256, "c": canonical sha256}; a bare string is the
# pre-1.1.0 file, which held the raw hash alone. The canonical hash is what
# makes the record survive a KiCad re-save — see kicad_canon.py for why a raw
# hash on its own reports 183 edited symbols after one edit.
_LOCAL: dict = {}


def _load_local_state() -> None:
    global _LOCAL
    if LOCAL_STATE_FILE.exists():
        try:
            _LOCAL = json.loads(LOCAL_STATE_FILE.read_text())
        except ValueError:
            _LOCAL = {}


def _save_local_state() -> None:
    LOCAL_STATE_FILE.write_text(json.dumps(_LOCAL, indent=0))


def _unchanged(key: str, data: bytes) -> bool:
    """True when `data` is still what this plugin wrote for `key`."""
    return matches(_LOCAL.get(key), data)


def _record_written(target: Path, payload: bytes, skip: set | None = None) -> None:
    """Baseline for the clobber check, and for what Push diffs against.

    Footprints are one file each, so the file is the unit. Symbols all live in
    ONE generated library, so the unit is an entry inside it — record those too
    or Push cannot tell which symbol you edited.

    `skip` names entries whose record must SURVIVE: after a merge the file on
    disk carries the user's unsent edit, and re-recording it would both let the
    next sync overwrite that edit and make Push forget it exists. The file-level
    record is left alone for the same reason.
    """
    if target.suffix == ".kicad_mod":
        _LOCAL[str(target)] = record(payload)
    elif target.suffix == ".kicad_sym":
        text = payload.decode("utf-8", "replace")
        entries = split_symbols(text)
        prefix = f"{target}::"
        live = {name for name, _ in entries}
        for key in [k for k in _LOCAL
                    if k.startswith(prefix) and k[len(prefix):] not in live]:
            del _LOCAL[key]  # the entry is gone from the library
        if not skip:
            _LOCAL[str(target)] = record(payload)
        for name, entry in entries:
            if skip and name in skip:
                continue
            _LOCAL[prefix + name] = record(entry)


def _merge_symbols(target: Path, payload: bytes, current: bytes) -> tuple[bytes, list[str]]:
    """The platform's symbol library with the locally edited entries kept.

    Returns the bytes to write and the names that were kept. Every base symbol
    lives in one generated file, so the whole-file rule "never overwrite an
    edited file" froze all 183 of them the moment one was edited — the unit of
    protection has to be the entry.
    """
    up_text = payload.decode("utf-8", "replace")
    lo_text = current.decode("utf-8", "replace")
    upstream = dict(split_symbols(up_text))
    keep: list[str] = []
    for name, entry in split_symbols(lo_text):
        twin = upstream.get(name)
        if twin is not None and canon_hash(entry) == canon_hash(twin):
            continue  # same drawing either way — take the platform's copy
        if _unchanged(f"{target}::{name}", entry.encode("utf-8")):
            continue  # untouched here: upstream changed it, or removed it
        keep.append(name)
    if not keep:
        return payload, []
    return merge_symbol_lib(up_text, lo_text, set(keep)).encode("utf-8"), keep


def _sync_models_delta(pkg: dict, state: dict) -> str:
    """Incremental models update: diff the mirror manifest against what is
    installed and fetch ONLY changed files as an LZMA-compressed batch.
    Raises to signal 'use the full package zip instead' (first install or
    huge delta)."""
    ident = pkg["identifier"]
    sha = pkg["versions"][0]["download_sha256"]
    dest = THIRD_PARTY / "3dmodels" / ident.replace(".", "_")
    if state.get(ident) == sha and dest.exists():
        return "fresh"
    if not dest.exists():
        raise RuntimeError("first install — full package needed")

    manifest = json.loads(_get(f"{BASE_URL}/files/manifest.json", timeout=120))
    upstream = {e["path"]: e["sha256"] for e in manifest["files"]
                if e["path"].startswith("3DModels/")}
    local: dict = {}
    if MODELS_STATE_FILE.exists():
        try:
            local = json.loads(MODELS_STATE_FILE.read_text())
        except ValueError:
            pass

    def local_sha(rel: str):
        f = dest / rel[len("3DModels/"):]
        if not f.is_file():
            return None
        if rel not in local:  # seed lazily (first delta after a PCM install)
            local[rel] = hashlib.sha256(f.read_bytes()).hexdigest()
        return local[rel]

    need = [rel for rel, s in upstream.items() if local_sha(rel) != s]
    if len(need) > DELTA_MAX_FILES:
        raise RuntimeError("delta too large — full package needed")

    if need:
        _notify(f"Downloading {len(need)} changed model file(s)…")
        data = _post_json(f"{BASE_URL}/api/kicad/pcm/models-delta", {"paths": need})
        zf = zipfile.ZipFile(io.BytesIO(data))
        for member in zf.infolist():
            if member.is_dir():
                continue
            rel = member.filename
            if not rel.startswith("3DModels/") or ".." in rel:
                continue
            target = dest / rel[len("3DModels/"):]
            target.parent.mkdir(parents=True, exist_ok=True)
            payload = zf.read(member)
            target.write_bytes(payload)
            local[rel] = hashlib.sha256(payload).hexdigest()

    # prune models removed upstream
    removed = 0
    for f in list(dest.rglob("*")):
        if f.is_file() and f"3DModels/{f.relative_to(dest).as_posix()}" not in upstream:
            f.unlink()
            removed += 1
    local = {rel: s for rel, s in local.items() if rel in upstream}

    MODELS_STATE_FILE.write_text(json.dumps(local, indent=0))
    state[ident] = sha
    STATE_FILE.write_text(json.dumps(state, indent=1))
    return "updated" if (need or removed) else "fresh"


def _apply_package(pkg: dict, state: dict) -> str:
    """Install/refresh one library package. Returns 'updated' | 'fresh'."""
    ident = pkg["identifier"]
    dest_name = ident.replace(".", "_")  # KiCad's install-directory convention
    ver = pkg["versions"][0]
    sha = ver["download_sha256"]
    targets_exist = any((THIRD_PARTY / kind / dest_name).exists() for kind in MANAGED_KINDS)
    if state.get(ident) == sha and targets_exist:
        return "fresh"

    data = _get(ver["download_url"])
    if hashlib.sha256(data).hexdigest() != sha:
        raise RuntimeError(f"{pkg['name']}: download checksum mismatch")

    zf = zipfile.ZipFile(io.BytesIO(data))
    written: dict[str, set[str]] = {}
    kept_local: list[str] = []
    settled: list[str] = []
    for member in zf.infolist():
        if member.is_dir():
            continue
        parts = Path(member.filename).parts
        if len(parts) < 2 or parts[0] not in MANAGED_KINDS:
            continue
        kind, rel = parts[0], Path(*parts[1:])
        target = THIRD_PARTY / kind / dest_name / rel
        written.setdefault(kind, set()).add(rel.as_posix())
        payload = zf.read(member)
        skip: set = set()
        current = target.read_bytes() if target.is_file() else None
        # NEVER clobber work edited here and not yet sent — that is somebody's
        # unsent drawing. The test is CURRENT FILE vs what we recorded writing:
        # comparing the incoming payload against the record instead would mean
        # "upstream changed, so keep the local copy", which refuses every
        # legitimate update — the exact opposite of the intent.
        # Library files only: a 3D model carries no record, so an unscoped test
        # would try to parse 1.4 GB of STEP as s-expressions on every full sync.
        if (target.suffix in LIB_SUFFIXES and current is not None
                and not _unchanged(str(target), current)):
            if canon_hash(current.decode("utf-8", "replace")) == \
                    canon_hash(payload.decode("utf-8", "replace")):
                # The local edit IS the platform's copy now: it was pushed and
                # approved and has come back, or KiCad merely re-saved the file
                # in its own spelling. Take the platform bytes and re-record —
                # without this the file stays "edited" for ever and Push keeps
                # offering to propose it again (reported 2026-08-20).
                settled.append(target.name)
            elif target.suffix == ".kicad_sym":
                payload, kept = _merge_symbols(target, payload, current)
                skip = set(kept)
                kept_local.extend(f"{n} (symbol)" for n in kept)
            else:
                kept_local.append(target.name)
                continue
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(payload)
        _record_written(target, payload, skip)

    # prune files we manage that no longer exist upstream
    for kind, keep in written.items():
        root = THIRD_PARTY / kind / dest_name
        for f in root.rglob("*"):
            if f.is_file() and f.relative_to(root).as_posix() not in keep:
                # A library file this plugin did not write last is either a
                # local edit or a footprint drawn here that was never pushed.
                # Deleting it would destroy work that Push exists to send.
                # Models carry no record at all, so they prune as before.
                if f.suffix in LIB_SUFFIXES and not _unchanged(str(f), f.read_bytes()):
                    kept_local.append(f.name)
                    continue
                f.unlink()
        # a pruned duplicate folder ("7Sigma 2.pretty") otherwise lingers empty
        # forever, and KiCad registers every .pretty it finds as a library
        for d in sorted((p for p in root.rglob("*") if p.is_dir()),
                        key=lambda p: len(p.parts), reverse=True):
            if not any(d.iterdir()):
                d.rmdir()
    _save_local_state()
    if kept_local:
        _notify("Kept your local edits (not overwritten): " + ", ".join(sorted(set(kept_local)))
                + ". Use 'Push 7Sigma changes' to send them.")
    if settled:
        _notify(f"{len(settled)} local edit(s) now match the platform and are no longer "
                "pending: " + ", ".join(sorted(set(settled))))

    state[ident] = sha
    STATE_FILE.write_text(json.dumps(state, indent=1))
    if ident == MODELS_ID:
        # full-zip path invalidates the per-file delta bookkeeping
        MODELS_STATE_FILE.unlink(missing_ok=True)
    return "updated"


def main() -> int:
    if not _acquire_lock():
        _notify("A sync is already running — hold on, it will notify when done.")
        return 0
    try:
        _load_local_state()
        _notify("Checking for 7Sigma library updates…")
        try:
            repo = json.loads(_get(f"{BASE_URL}/api/kicad/pcm/repository.json", timeout=120))
            packages = json.loads(_get(repo["packages"]["url"], timeout=120))["packages"]
        except Exception as e:
            _notify(f"Sync failed: cannot reach the platform — {e}")
            return 1

        state: dict = {}
        if STATE_FILE.exists():
            try:
                state = json.loads(STATE_FILE.read_text())
            except ValueError:
                pass

        updated, fresh, failed = [], [], []
        for pkg in packages:
            if pkg.get("type") != "library":
                continue  # never self-update the plugin from inside itself
            try:
                result = None
                if pkg["identifier"] == MODELS_ID:
                    # models: incremental per-file delta (LZMA) when possible
                    try:
                        result = _sync_models_delta(pkg, state)
                    except Exception:
                        result = None  # fall back to the full package zip
                if result is None:
                    if state.get(pkg["identifier"]) != pkg["versions"][0]["download_sha256"] \
                            and pkg["versions"][0]["download_size"] > 10 * 1024 * 1024:
                        _notify(f"Downloading {pkg['name']} "
                                f"({pkg['versions'][0]['download_size'] >> 20} MB)…")
                    result = _apply_package(pkg, state)
                (updated if result == "updated" else fresh).append(pkg["name"])
            except Exception as e:
                failed.append(f"{pkg['name']}: {e}")

        if failed:
            _notify("Sync errors: " + "; ".join(failed))
            return 1
        if updated:
            _notify(f"Updated: {', '.join(updated)}. Reopen the symbol chooser to pick up changes.")
        else:
            _notify("Library already up to date.")
        return 0
    finally:
        LOCK_FILE.unlink(missing_ok=True)


if __name__ == "__main__":
    sys.exit(main())
