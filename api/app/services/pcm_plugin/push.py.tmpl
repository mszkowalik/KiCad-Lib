#!/usr/bin/env python3
"""Push 7Sigma changes — KiCad IPC action plugin entrypoint.

The other half of ``sync.py``. Sync PULLS the library onto this machine;
this PUSHES local edits back, with the 3D models they reference.

Why it exists: KiCad's clipboard is not a usable transport. A footprint-object
copy never reaches the system clipboard at all, and a select-all copy carries
shape only — no 3D model, no ``(attr)``, empty Reference/Value, and an
arbitrary origin that moves between copies. The file the footprint editor
SAVES has all of it. So the workflow is: edit the footprint in place in the
installed ``7Sigma.pretty`` library, press Ctrl+S, then press this button.

The button lives in the PCB editor, not the footprint editor: KiCad implements
the IPC plugin system there only (dev-docs, "For Add-on Developers"). That
costs nothing here — this reads the SAVED files off disk, so which editor has
focus is irrelevant. The footprint/symbol scopes in plugin.json are declared
for the day KiCad honours them.

Each selected footprint or symbol becomes a new version on the platform
(footprints and symbols auto-publish since 2026-08-23; accountability lives on
the review axis, not on a draft gate). A footprint whose 3D model sits outside
the library — in ~/Downloads, in KiCad's own 3dmodels tree, beside a project —
carries that file with it: Push uploads the model, rewrites the reference to
`${SEVENSIGMA_DIR}/3DModels/…`, and repoints the local copy at the installed
one. So does one whose model was dropped into the INSTALLED library's own
3dmodels tree — that path reads as a library reference after
`to_platform_text`, so it has to be checked against what the library actually
holds rather than trusted. See `_plan_models`, model_paths.py and model_ui.py.

"Edited" is decided against a CANONICAL form of the drawing (kicad_canon.py),
never against the bytes: KiCad rewrites the whole file it saves in its own
spelling, so a byte comparison called all 183 symbols edited after one edit.

Only dependency: certifi (see requirements.txt — KiCad's bundled Python has
no CA store on macOS).
"""
from __future__ import annotations

import hashlib
import json
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))  # KiCad runs this as a script; be explicit anyway
from kicad_canon import canon_hash, matches, record, split_symbols  # noqa: E402
import model_ui  # noqa: E402 — same reason
from model_paths import (  # noqa: E402
    MODEL_PREFIX, is_library_path, model_paths, rel_of, resolve,
    rewrite_model_path, suggest_rel_path, var_names,
)

BASE_URL = "__BASE_URL__"
LIB_DIR_NAME = "com_sevensigma_library"  # com.sevensigma.library, KiCad's dot->underscore rule
MODELS_INSTALL_DIR = "com_sevensigma_models3d"
# The KiCad path variable the packager writes into installed footprints. Baked
# in by pcm.py (THIRD_PARTY_VAR) so the two never drift — it is version-stamped
# and moves with each KiCad major release.
THIRD_PARTY_VAR = "__THIRD_PARTY_VAR__"
PRETTY = "7Sigma.pretty"
SYM_FILE = "7Sigma_Base.kicad_sym"
THIRD_PARTY = HERE.parents[1]  # .../3rdparty/plugins/<id>/ -> .../3rdparty
LOCAL_DIR = THIRD_PARTY / "footprints" / LIB_DIR_NAME / PRETTY
SYM_LIB = THIRD_PARTY / "symbols" / LIB_DIR_NAME / SYM_FILE
LOCAL_STATE_FILE = HERE / "local_state.json"  # written by sync.py: what it installed


def _notify(message: str) -> None:
    print(message)
    if sys.platform == "darwin":
        try:
            quoted = json.dumps(message, ensure_ascii=False)  # AppleScript chokes on \uXXXX
            subprocess.run(
                ["osascript", "-e",
                 f'display notification {quoted} with title "7Sigma Library"'],
                check=False, timeout=10,
            )
        except Exception:
            pass


def _osascript(script: str) -> str | None:
    """Run AppleScript, returning its output, or None when the user cancels.

    Cancelling any dialog makes osascript exit non-zero, which is exactly the
    signal we want: no selection, push nothing.
    """
    try:
        p = subprocess.run(["osascript", "-e", script], capture_output=True,
                           text=True, timeout=300)
    except Exception:
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def _as_list(items: list[str]) -> str:
    """An AppleScript list literal."""
    return "{" + ", ".join('"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
                           for s in items) + "}"


def _confirm(names: list[str]) -> list[str] | None:
    """Ask which footprints and symbols to send. Everything is ticked to start
    with, so the common case — send them all — is one Return press.

    Returns the chosen names, or None when the user cancels or no dialog is
    available. Never falls through to pushing without an answer.
    """
    if sys.platform != "darwin":
        _notify("Cannot confirm: this dialog needs macOS. Nothing was sent.")
        return None
    lst = _as_list(names)
    plural = "item" if len(names) == 1 else "items"
    out = _osascript(
        f'set L to {lst}\n'
        f'set picked to choose from list L with title "Push to 7Sigma" '
        f'with prompt "{len(names)} changed {plural}. Send to the platform?" '
        f'default items L with multiple selections allowed '
        f'OK button name "Send" cancel button name "Cancel"\n'
        'if picked is false then error number -128\n'
        'set AppleScript\'s text item delimiters to linefeed\n'
        'return picked as text'
    )
    if out is None:
        return None
    return [n for n in out.splitlines() if n]


def _ask_comment(n: int) -> str | None:
    out = _osascript(
        f'display dialog "What changed? Shown in the proposal review." '
        f'with title "Push {n} to 7Sigma" default answer "Edited in the KiCad footprint editor"\n'
        'return text returned of result'
    )
    return None if out is None else (out.strip() or "Edited in the KiCad footprint editor")


TOKEN = "__TOKEN__"          # baked in when installed from a personal repository URL
TOKEN_FILE = HERE / "token.json"
AGENT = "sevensigma-push/1.0"


def _ssl_context():
    """Same helper as sync.py — see the comment there. KiCad's bundled Python
    has no usable CA store on macOS, so a context must name one explicitly."""
    import ssl
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except Exception:
        pass
    cafile = "/etc/ssl/cert.pem"
    try:
        if Path(cafile).exists():
            return ssl.create_default_context(cafile=cafile)
    except Exception:
        pass
    return None


_SSL_CTX = _ssl_context()

AUTH_HINT = (
    "The platform rejected this plugin's credentials.\n\n"
    "Fix it one of two ways:\n"
    "1. Reinstall the plugin from your personal repository URL "
    "(Setup page > KiCad), which bakes a fresh token in.\n"
    "2. Put {\"token\": \"7s_…\"} in token.json next to this plugin."
)


def _token() -> str:
    """The platform API token — baked in at install time, else `token.json`.

    Push WRITES (library versions and 3D model files), so this credential also
    carries the identity the new version is attributed to. A shared token would
    make every push anonymous.
    """
    global TOKEN
    if TOKEN:
        return TOKEN
    try:
        TOKEN = str(json.loads(TOKEN_FILE.read_text(encoding="utf-8")).get("token", ""))
    except Exception:
        TOKEN = ""
    return TOKEN


def _headers(extra: dict | None = None) -> dict:
    h = {"User-Agent": AGENT}
    token = _token()
    if token:
        h["Authorization"] = "Bearer " + token
    if extra:
        h.update(extra)
    return h


def _get_json(url: str, timeout: int = 120):
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        raise


def _get_text(url: str, timeout: int = 120) -> str:
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        raise


def _post_json(url: str, payload: dict, timeout: int = 180) -> tuple[int, dict]:
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers=_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.status, json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        body = e.read()
        try:
            return e.code, json.loads(body)
        except ValueError:
            return e.code, {"detail": {"error": body[:200].decode("utf-8", "replace")}}


def _post_multipart(url: str, filename: str, data: bytes,
                    timeout: int = 900) -> tuple[int, dict]:
    """One file to a `UploadFile = File(...)` endpoint, field name "file".

    Hand-rolled because the plugin runs on KiCad's bundled Python with no
    requests/httpx — the same reason every other call here is urllib. The
    boundary is derived from the payload so it can never occur inside it.
    """
    boundary = "----7sigma" + hashlib.sha256(data).hexdigest()[:32]
    head = (f"--{boundary}\r\n"
            f'Content-Disposition: form-data; name="file"; filename="{filename}"\r\n'
            "Content-Type: application/octet-stream\r\n\r\n").encode("utf-8")
    body = head + data + f"\r\n--{boundary}--\r\n".encode("utf-8")
    req = urllib.request.Request(url, data=body, headers=_headers({
        "Content-Type": f"multipart/form-data; boundary={boundary}",
        "Content-Length": str(len(body)),
    }))
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.status, json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        raw = e.read()
        try:
            return e.code, json.loads(raw)
        except ValueError:
            return e.code, {"detail": raw[:200].decode("utf-8", "replace")}
    except Exception as e:  # noqa: BLE001 — timeout, connection reset, DNS
        return 0, {"detail": repr(e)}


# --------------------------------------------------------------- 3D models

def _stock_models_dir() -> Path | None:
    """KiCad's own 3dmodels tree, so a model picked out of it resolves.

    KiCad keeps `KICAD*_3DMODEL_DIR` in its own settings and does not export it
    to a plugin's environment, so the value has to be guessed from the install
    layout. A miss is harmless: the file simply reads as "cannot find", which
    is reported rather than acted on.
    """
    for p in (Path("/Applications/KiCad/KiCad.app/Contents/SharedSupport/3dmodels"),
              Path("/usr/share/kicad/3dmodels"),
              Path("/usr/local/share/kicad/3dmodels"),
              Path("C:/Program Files/KiCad/share/kicad/3dmodels")):
        if p.is_dir():
            return p
    return None


def _path_vars(names) -> dict:
    """What KiCad's path variables mean on this machine, for the names asked
    about. Only the two families a 3D model reference realistically uses."""
    out: dict[str, str] = {}
    for n in names:
        if n.endswith("_3RD_PARTY"):
            out[n] = str(THIRD_PARTY)
        elif n.endswith("_3DMODEL_DIR"):
            stock = _stock_models_dir()
            if stock is not None:
                out[n] = str(stock)
    return out


def installed_model_path(rel: str) -> str:
    """`rel` as the installed library spells it — what a local file must say so
    KiCad renders the model straight after a push, and what the next sync will
    write for the same footprint (so the two compare equal and settle)."""
    return f"${{{THIRD_PARTY_VAR}}}/3dmodels/{MODELS_INSTALL_DIR}/{rel}"


_MODEL_ROWS: dict[str, dict | None] = {}


def _stored_model(rel: str) -> dict | None:
    """The library's record for `3DModels/<rel>`, or None when it holds no such
    file. Raises when the question could not be asked — the caller must not read
    a failed request as "absent" and re-upload over a stored model.

    Asked one rel at a time rather than by listing everything: the list endpoint
    caps at 300 rows and the library is already close to that, so a listing
    could answer "absent" about a model that is simply on the next page.
    """
    if rel not in _MODEL_ROWS:
        res = _get_json(f"{BASE_URL}/api/models3d"
                        f"?query={urllib.parse.quote(rel)}&limit=300")
        _MODEL_ROWS[rel] = next(
            (r for r in (res.get("models") or []) if r.get("rel_path") == rel), None)
    return _MODEL_ROWS[rel]


def _sha256(src: Path) -> str | None:
    """The file's digest in the spelling `/api/models3d` reports, or None when it
    cannot be read."""
    try:
        return hashlib.sha256(src.read_bytes()).hexdigest()
    except OSError:
        return None


def _plan_models(name: str, path: Path, fid) -> tuple[list[dict], str | None]:
    """The 3D models one footprint references that the library does not hold.

    Two kinds, both needing the same upload:

    * **Off-library** — a STEP in ~/Downloads, in KiCad's own 3dmodels tree, or
      beside a project. Where it lands under `3DModels/` is a decision, so the
      suggestion is shown and editable in the dialog.
    * **A library path the library does not actually have.** The installed
      library's own 3dmodels tree is the one place `to_platform_text` rewrites
      into a `${SEVENSIGMA_DIR}` reference, so a file dropped in there BY HAND
      reads as "already stored". Trusting that filed a footprint pointing at
      bytes the platform had never seen, and its `fp.model3d` check failed after
      publishing (D_SOD-123FL v5, 2026-08-25).
    * **A library path whose bytes CHANGED here.** Editing the STEP in place, at
      the path the footprint already names, is the normal way a wrong model gets
      corrected — and "the row exists" would skip it, so the fix would never
      leave this machine. The local digest is compared against the store's, and
      a difference plans an upload that REPLACES that `rel_path`.

    For both library cases the `rel` is the path the footprint already names, so
    it is prefilled rather than suggested. A replacement is not private to one
    footprint: every footprint pointing at that `rel_path` gets the new solid,
    which is why `_upload_models` announces it as "Replacing".

    Returns (items, error). An item carries `footprint`, `src` (the file on this
    machine), `local` (the path the LOCAL file writes, for the relink), `orig`
    (the path the PUSHED text will spell, for the reference rewrite) and `rel`
    (where it goes under 3DModels/). The error is set when a reference names a
    file that is not there — the push of THAT footprint has to stop, because the
    platform would reject it anyway, with a worse message.
    """
    refs = dict.fromkeys(model_paths(path.read_text(encoding="utf-8")))
    if not refs:
        return [], None
    existing: list = []
    if fid is not None:
        try:
            existing = _get_json(f"{BASE_URL}/api/footprints/{fid}").get("models") or []
        except Exception:  # noqa: BLE001 — only affects the suggested folder
            existing = []
    items, missing, unchecked = [], [], []
    for ref in refs:  # each distinct path once, order kept
        plat = to_platform_text(ref)  # how the pushed text will spell it
        rel, stored = "", None
        if is_library_path(plat):
            rel = rel_of(plat)
            try:
                stored = _stored_model(rel)
            except Exception:  # noqa: BLE001 — cannot tell, so change nothing
                unchecked.append(rel)
                continue
        src = resolve(ref, _path_vars(var_names(ref)), path.parent)
        if src is None:
            if stored is not None:
                continue  # the library holds it; this machine just has no copy
            missing.append(ref)
            continue
        if stored is not None:
            local_sha = _sha256(src)
            if local_sha is None or not stored.get("sha256"):
                unchecked.append(rel)  # cannot compare — never overwrite blind
                continue
            if local_sha == stored["sha256"]:
                continue  # byte-identical to the library — nothing to send
        items.append({"footprint": name, "src": src, "local": ref, "orig": plat,
                      "rel": rel or suggest_rel_path(src, existing),
                      "replaces": stored})
    if unchecked:
        _notify(f"{name}: could not check whether the library holds "
                + ", ".join(unchecked) + " — sent the reference unchanged.")
    if missing:
        return items, ("cannot find the 3D model file(s) it references: "
                       + ", ".join(missing))
    return items, None


def _upload_models(items: list[dict]) -> list[str]:
    """Upload every planned model, once per target path. Marks each item `ok`
    or `error`; returns the human-readable failures."""
    errors: list[str] = []
    done: dict[str, Path] = {}
    for it in items:
        rel, src = it["rel"], it["src"]
        prev = done.get(rel)
        if prev is not None:
            if prev == src:
                it["ok"] = True  # two footprints, same file — uploaded already
            else:
                it["error"] = f"two different files both target 3DModels/{rel}"
                errors.append(f"{it['footprint']}: {it['error']}")
            continue
        try:
            data = src.read_bytes()
        except OSError as e:
            it["error"] = f"cannot read {src}: {e}"
            errors.append(f"{it['footprint']}: {it['error']}")
            continue
        verb = "Replacing" if it.get("replaces") else "Uploading"
        _notify(f"{verb} {src.name} ({len(data) >> 10} kB) as 3DModels/{rel}…")
        status, res = _post_multipart(
            f"{BASE_URL}/api/models3d/upload?rel_path={urllib.parse.quote(rel)}",
            src.name, data)
        if status == 200 and res.get("ok"):
            done[rel] = src
            it["ok"] = True
            it["data"] = data
        else:
            detail = res.get("detail") or res
            if isinstance(detail, dict):
                detail = detail.get("error") or json.dumps(detail)[:200]
            it["error"] = f"upload failed ({status}): {detail}"
            errors.append(f"{it['footprint']}: {it['error']}")
    return errors


def _install_model_locally(rel: str, data: bytes) -> None:
    """Put the uploaded bytes where the installed library keeps its models, so
    the footprint renders now instead of after the next sync. The next sync
    finds the same sha256 in the manifest and downloads nothing."""
    try:
        target = THIRD_PARTY / "3dmodels" / MODELS_INSTALL_DIR / rel
        target.parent.mkdir(parents=True, exist_ok=True)
        if not target.is_file() or target.read_bytes() != data:
            target.write_bytes(data)
    except OSError:
        pass  # cosmetic — the model is in the library, sync will fetch it


def _relink_local(path: Path, plan: list[dict]) -> None:
    """Repoint the LOCAL footprint at the stored model.

    Without this the file keeps naming ~/Downloads: the model would vanish from
    the board the day that folder is cleared, and every later push would upload
    it again. A model the user had already dropped into the installed tree is
    the one case where this changes nothing, and then the file is left alone
    rather than rewritten with its own bytes. The baseline in local_state.json
    is deliberately NOT re-recorded —
    the next sync compares this file against the platform's copy, finds the same
    drawing, and settles it there, which is the one path that cannot lose an
    edit if the mirror is still rebuilding.
    """
    try:
        before = path.read_text(encoding="utf-8")
        text = before
        for it in plan:
            text = rewrite_model_path(text, it["local"], installed_model_path(it["rel"]))
        if text != before:  # a model already installed where it belongs needs no write
            path.write_text(text, encoding="utf-8")
    except OSError as e:
        _notify(f"Uploaded the model but could not rewrite {path.name}: {e}")


_ENTRIES: dict | None = None


def installed_symbols() -> dict:
    """Every installed symbol entry by name. Read once — the library is 1.3 MB."""
    global _ENTRIES
    if _ENTRIES is None:
        _ENTRIES = dict(split_symbols(SYM_LIB.read_text(encoding="utf-8"))) \
            if SYM_LIB.is_file() else {}
    return _ENTRIES


def to_platform_symbol_entry(name: str) -> str:
    """One installed symbol entry, in the spelling the platform stores.

    Undoes the packager's nickname rewrite: it turns `"7Sigma:` into
    `"PCM_7Sigma:` so footprint refs resolve against the installed library.
    The platform stores the `7Sigma:` form, so a push must put it back or the
    proposal would flip every footprint reference in the symbol.
    """
    return installed_symbols()[name].replace('"PCM_7Sigma:', '"7Sigma:')


def to_platform_symbol(name: str) -> str:
    """That entry wrapped as the .kicad_sym library the platform accepts."""
    return (
        '(kicad_symbol_lib\n\t(version 20251024)\n\t(generator "kicad_symbol_editor")\n'
        '\t(generator_version "10.0")\n' + to_platform_symbol_entry(name) + "\n)\n"
    )


def to_platform_text(text: str) -> str:
    """Undo the packager's 3D-model path rewrite.

    `pcm.py` turns `${SEVENSIGMA_DIR}/3DModels/` into
    `${KICAD10_3RD_PARTY}/3dmodels/com_sevensigma_models3d/` when it builds the
    package, because that is where the models install. The platform validator
    only accepts the `${SEVENSIGMA_DIR}` form, so a push MUST put it back or
    every footprint carrying a model is refused. The variable name is matched
    loosely — it is version-stamped (KICAD10_…) and will change with KiCad.
    """
    return re.sub(r"\$\{[A-Z0-9_]+\}/3dmodels/" + re.escape(MODELS_INSTALL_DIR) + "/",
                  "${SEVENSIGMA_DIR}/3DModels/", text)


def _load_state() -> dict:
    if LOCAL_STATE_FILE.exists():
        try:
            return json.loads(LOCAL_STATE_FILE.read_text())
        except ValueError:
            pass
    return {}


def _save_state(state: dict) -> None:
    """Write the baseline back atomically — Sync writes this file too."""
    tmp = LOCAL_STATE_FILE.with_suffix(".json.part")
    tmp.write_text(json.dumps(state, indent=0))
    tmp.replace(LOCAL_STATE_FILE)


def _changed(baseline: dict) -> list[tuple[str, str, Path, bool]]:
    """Items edited on this machine: (kind, name, path, is_new).

    The baseline is what SYNC WROTE (`local_state.json`), never the mirror
    manifest — the installed bytes legitimately differ from the mirror because
    of the model-path rewrite above, so a manifest diff calls all 155
    model-carrying footprints "edited". Comparing against our own record is
    exact and survives any future transformation.

    The comparison is CANONICAL (`kicad_canon.matches`): KiCad rewrites the
    whole file it saves, in its own spelling, so a byte comparison reported
    every symbol in the library as edited after a single edit.

    A MISSING record means "unknown", never "unchanged", and unknown items are
    FLAGGED. Sync deliberately withholds a record for an entry it kept back
    (`_record_written(..., skip=…)`), so the very drawings this button exists
    to send are the ones with no baseline: an edit made before the first sync
    that protected it never got one, and no later sync writes one either.
    BTS723GW sat unpushable for exactly that reason — Push reported "no local
    changes" over a moved pin (2026-08-21). `_drop_settled` then decides every
    flagged item against the live mirror: same drawing, record a baseline and
    drop it; different drawing, offer it. That costs one request per unknown
    footprint and one for the whole symbol library, so a machine with no state
    file pays ~200 small requests once and ends up with a correct baseline.
    """
    upstream_names = {
        e["path"].split("/")[-1]
        for e in _get_json(f"{BASE_URL}/files/manifest.json")["files"]
        if e["path"].startswith(f"Footprints/{PRETTY}/")
    }
    out = []
    for f in sorted(LOCAL_DIR.glob("*.kicad_mod")):
        rec = baseline.get(str(f))
        if rec is None and f.name not in upstream_names:
            out.append(("footprint", f.stem, f, True))  # not in the library — a creation
        elif not matches(rec, f.read_bytes()):
            out.append(("footprint", f.stem, f, False))

    # symbols all live in ONE generated library file, so the unit of change is
    # an entry inside it, not the file — diff per entry against the baseline
    if SYM_LIB.is_file():
        for name, entry in installed_symbols().items():
            if not matches(baseline.get(f"{SYM_LIB}::{name}"), entry):
                out.append(("symbol", name, SYM_LIB, False))
    return out


def _drop_settled(changed: list, baseline: dict) -> tuple[list, list[str]]:
    """Drop the flagged items whose drawing already IS the platform's current one.

    A stale baseline is not hypothetical. Before plugin 1.1.0 a sync that
    refused to overwrite a local edit never re-recorded it, so a footprint that
    had been pushed, approved and synced stayed flagged for ever and this
    dialog kept offering to propose it again — reported 2026-08-20, five
    footprints. Checking the FLAGGED items (only those) against the live mirror
    costs one request each, corrects the baseline, and makes the whole
    bookkeeping self-healing. It is also where an item with NO baseline gets
    one: `_changed` flags those rather than hiding them, and this is what tells
    an unrecorded local edit from an unrecorded untouched file. A fetch that fails leaves the item flagged:
    offering an edit twice is annoying, losing one is not recoverable.
    """
    still, settled, upstream_syms = [], [], None
    for item in changed:
        kind, name, path, is_new = item
        if is_new:
            still.append(item)  # nothing upstream to compare against
            continue
        try:
            if kind == "symbol":
                if upstream_syms is None:
                    upstream_syms = dict(split_symbols(
                        _get_text(f"{BASE_URL}/files/Symbols/{SYM_FILE}")))
                theirs = upstream_syms.get(name)
                mine = to_platform_symbol_entry(name)
                current = installed_symbols()[name]  # PCM_ spelling, as sync wrote it
                key = f"{SYM_LIB}::{name}"
            else:
                quoted = urllib.parse.quote(f"{name}.kicad_mod")
                theirs = _get_text(f"{BASE_URL}/files/Footprints/{PRETTY}/{quoted}")
                current = path.read_text(encoding="utf-8")
                mine = to_platform_text(current)
                key = str(path)
        except Exception:
            still.append(item)
            continue
        if theirs is not None and canon_hash(mine) == canon_hash(theirs):
            baseline[key] = record(current)  # record it AS INSTALLED, like sync does
            settled.append(name)
        else:
            still.append(item)
    return still, settled


def main() -> int:
    if not LOCAL_DIR.is_dir():
        _notify(f"No local 7Sigma library at {LOCAL_DIR} — run Sync first.")
        return 1
    baseline = _load_state()
    try:
        changed = _changed(baseline)
        changed, settled = _drop_settled(changed, baseline)
    except Exception as e:
        _notify(f"Push failed: cannot reach the platform — {e}")
        return 1
    if settled:
        _save_state(baseline)
    if not changed:
        msg = "No local changes — every footprint and symbol matches the platform."
        if settled:
            msg += f" ({len(settled)} were already approved and are now cleared.)"
        _notify(msg)
        return 0

    labels = [f"{name}  [{kind}]{'  (new)' if is_new else ''}"
              for kind, name, _, is_new in changed]
    picked = _confirm(labels)
    if not picked:
        _notify("Nothing sent.")
        return 0
    comment = _ask_comment(len(picked))
    if comment is None:
        _notify("Nothing sent.")
        return 0

    by_label = {lbl: entry for lbl, entry in zip(labels, changed)}
    try:
        ids = {f["name"]: f["id"] for f in _get_json(f"{BASE_URL}/api/footprints")}
        sym_ids = {s["name"]: s["id"] for s in _get_json(f"{BASE_URL}/api/symbols")}
    except Exception as e:
        _notify(f"Push failed: cannot list the library — {e}")
        return 1

    # --- 3D models -------------------------------------------------------
    # A footprint drawn here points its (model …) at wherever the file sits on
    # this machine. The platform only stores library paths, so the file goes up
    # FIRST and the reference is rewritten — otherwise the push is refused and
    # the user is told to go and upload a STEP by hand.
    plans: list[dict] = []
    blocked: dict[str, str] = {}
    for kind, name, path, _is_new in (by_label[lbl] for lbl in picked if lbl in by_label):
        if kind != "footprint":
            continue
        items, err = _plan_models(name, path, ids.get(name))
        plans.extend(items)
        if err:
            blocked[name] = err
    if plans:
        chosen, backend = model_ui.confirm(plans)
        if chosen is None:
            _notify("Nothing sent — the 3D model step was cancelled.")
            return 0
        plans = chosen
        if backend in ("none", "too-many"):
            _notify(f"Could not open the 3D model window for {len(plans)} file(s) — "
                    "used the suggested paths under 3DModels/.")
        _upload_models(plans)
        for it in plans:
            if it.get("error"):
                blocked.setdefault(it["footprint"], it["error"])

    filed, failed = [], []
    for lbl in picked:
        entry = by_label.get(lbl)
        if entry is None:
            continue
        kind, name, path, _ = entry
        if name in blocked and kind == "footprint":
            failed.append(f"{name}: {blocked[name]}")
            continue
        if kind == "symbol":
            sid = sym_ids.get(name)
            if sid is None:
                failed.append(f"{name}: no such symbol on the platform")
                continue
            status, res = _post_json(f"{BASE_URL}/api/symbols/{sid}/propose",
                                     {"source_text": to_platform_symbol(name),
                                      "comment": comment})
        else:
            plan = [i for i in plans if i["footprint"] == name]
            text = to_platform_text(path.read_text(encoding="utf-8"))
            for it in plan:
                text = rewrite_model_path(text, it["orig"], MODEL_PREFIX + it["rel"])
            fid = ids.get(name)
            if fid is None:  # not in the library yet — a creation proposal
                status, res = _post_json(f"{BASE_URL}/api/footprints/propose",
                                         {"source_text": text, "comment": comment, "name": name})
            else:
                status, res = _post_json(f"{BASE_URL}/api/footprints/{fid}/propose",
                                         {"source_text": text, "comment": comment})
            if status == 200 and res.get("ok") and plan:
                # The library now owns the model — point the local copy at the
                # installed one and drop the bytes in beside it.
                for it in plan:
                    if it.get("data"):
                        _install_model_locally(it["rel"], it["data"])
                _relink_local(path, plan)
        if status == 200 and res.get("ok"):
            filed.append(f"{name} v{res['version_no']}")
        else:
            failed.append(f"{name}: {(res.get('detail') or res).get('error', status)}")

    if filed:
        _notify(f"Sent {len(filed)}: {', '.join(filed)}.")
    if failed:
        _notify("Push errors: " + "; ".join(failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
