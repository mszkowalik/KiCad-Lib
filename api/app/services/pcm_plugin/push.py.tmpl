#!/usr/bin/env python3
"""Push 7Sigma changes — KiCad IPC action plugin entrypoint.

The other half of ``sync.py``. Sync PULLS the library onto this machine;
this PUSHES local edits back as draft proposals.

Why it exists: KiCad's clipboard is not a usable transport. A footprint-object
copy never reaches the system clipboard at all, and a select-all copy carries
shape only — no 3D model, no ``(attr)``, empty Reference/Value, and an
arbitrary origin that moves between copies. The file the footprint editor
SAVES has all of it. So the workflow is: edit the footprint in place in the
installed ``7Sigma.pretty`` library, press Ctrl+S, then press this button.

The button lives in the PCB editor, not the footprint editor: KiCad implements
the IPC plugin system there only (dev-docs, "For Add-on Developers"). That
costs nothing here — this reads the SAVED files off disk, so which editor has
focus is irrelevant. The footprint/symbol scopes in plugin.json are declared
for the day KiCad honours them.

Nothing is published. Each selected footprint or symbol becomes a DRAFT the
user approves in the platform's Proposals view, with the usual before/after.

"Edited" is decided against a CANONICAL form of the drawing (kicad_canon.py),
never against the bytes: KiCad rewrites the whole file it saves in its own
spelling, so a byte comparison called all 183 symbols edited after one edit.

Only dependency: certifi (see requirements.txt — KiCad's bundled Python has
no CA store on macOS).
"""
from __future__ import annotations

import json
import re
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))  # KiCad runs this as a script; be explicit anyway
from kicad_canon import canon_hash, matches, record, split_symbols  # noqa: E402

BASE_URL = "__BASE_URL__"
LIB_DIR_NAME = "com_sevensigma_library"  # com.sevensigma.library, KiCad's dot->underscore rule
MODELS_INSTALL_DIR = "com_sevensigma_models3d"
PRETTY = "7Sigma.pretty"
SYM_FILE = "7Sigma_Base.kicad_sym"
THIRD_PARTY = HERE.parents[1]  # .../3rdparty/plugins/<id>/ -> .../3rdparty
LOCAL_DIR = THIRD_PARTY / "footprints" / LIB_DIR_NAME / PRETTY
SYM_LIB = THIRD_PARTY / "symbols" / LIB_DIR_NAME / SYM_FILE
LOCAL_STATE_FILE = HERE / "local_state.json"  # written by sync.py: what it installed


def _notify(message: str) -> None:
    print(message)
    if sys.platform == "darwin":
        try:
            quoted = json.dumps(message, ensure_ascii=False)  # AppleScript chokes on \uXXXX
            subprocess.run(
                ["osascript", "-e",
                 f'display notification {quoted} with title "7Sigma Library"'],
                check=False, timeout=10,
            )
        except Exception:
            pass


def _osascript(script: str) -> str | None:
    """Run AppleScript, returning its output, or None when the user cancels.

    Cancelling any dialog makes osascript exit non-zero, which is exactly the
    signal we want: no selection, push nothing.
    """
    try:
        p = subprocess.run(["osascript", "-e", script], capture_output=True,
                           text=True, timeout=300)
    except Exception:
        return None
    return p.stdout.strip() if p.returncode == 0 else None


def _as_list(items: list[str]) -> str:
    """An AppleScript list literal."""
    return "{" + ", ".join('"' + s.replace("\\", "\\\\").replace('"', '\\"') + '"'
                           for s in items) + "}"


def _confirm(names: list[str]) -> list[str] | None:
    """Ask which footprints to send. Everything is ticked to start with, so
    the common case — send them all — is one Return press.

    Returns the chosen names, or None when the user cancels or no dialog is
    available. Never falls through to pushing without an answer.
    """
    if sys.platform != "darwin":
        _notify("Cannot confirm: this dialog needs macOS. Nothing was sent.")
        return None
    lst = _as_list(names)
    plural = "item" if len(names) == 1 else "items"
    out = _osascript(
        f'set L to {lst}\n'
        f'set picked to choose from list L with title "Push to 7Sigma" '
        f'with prompt "{len(names)} changed {plural}. Send as draft proposals?" '
        f'default items L with multiple selections allowed '
        f'OK button name "Send" cancel button name "Cancel"\n'
        'if picked is false then error number -128\n'
        'set AppleScript\'s text item delimiters to linefeed\n'
        'return picked as text'
    )
    if out is None:
        return None
    return [n for n in out.splitlines() if n]


def _ask_comment(n: int) -> str | None:
    out = _osascript(
        f'display dialog "What changed? Shown in the proposal review." '
        f'with title "Push {n} to 7Sigma" default answer "Edited in the KiCad footprint editor"\n'
        'return text returned of result'
    )
    return None if out is None else (out.strip() or "Edited in the KiCad footprint editor")


TOKEN = "__TOKEN__"          # baked in when installed from a personal repository URL
TOKEN_FILE = HERE / "token.json"
AGENT = "sevensigma-push/1.0"


def _ssl_context():
    """Same helper as sync.py — see the comment there. KiCad's bundled Python
    has no usable CA store on macOS, so a context must name one explicitly."""
    import ssl
    try:
        import certifi
        return ssl.create_default_context(cafile=certifi.where())
    except Exception:
        pass
    cafile = "/etc/ssl/cert.pem"
    try:
        if Path(cafile).exists():
            return ssl.create_default_context(cafile=cafile)
    except Exception:
        pass
    return None


_SSL_CTX = _ssl_context()

AUTH_HINT = (
    "The platform rejected this plugin's credentials.\n\n"
    "Fix it one of two ways:\n"
    "1. Reinstall the plugin from your personal repository URL "
    "(Setup page > KiCad), which bakes a fresh token in.\n"
    "2. Put {\"token\": \"7s_…\"} in token.json next to this plugin."
)


def _token() -> str:
    """The platform API token — baked in at install time, else `token.json`.

    Push WRITES (it files draft proposals), so this credential also carries the
    identity the proposal is attributed to. A shared token would make every
    proposal anonymous.
    """
    global TOKEN
    if TOKEN:
        return TOKEN
    try:
        TOKEN = str(json.loads(TOKEN_FILE.read_text(encoding="utf-8")).get("token", ""))
    except Exception:
        TOKEN = ""
    return TOKEN


def _headers(extra: dict | None = None) -> dict:
    h = {"User-Agent": AGENT}
    token = _token()
    if token:
        h["Authorization"] = "Bearer " + token
    if extra:
        h.update(extra)
    return h


def _get_json(url: str, timeout: int = 120):
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        raise


def _get_text(url: str, timeout: int = 120) -> str:
    req = urllib.request.Request(url, headers=_headers())
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.read().decode("utf-8", "replace")
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        raise


def _post_json(url: str, payload: dict, timeout: int = 180) -> tuple[int, dict]:
    req = urllib.request.Request(
        url, data=json.dumps(payload).encode(),
        headers=_headers({"Content-Type": "application/json"}),
    )
    try:
        with urllib.request.urlopen(req, timeout=timeout, context=_SSL_CTX) as resp:
            return resp.status, json.loads(resp.read())
    except urllib.error.HTTPError as e:
        if e.code in (401, 403):
            _notify(AUTH_HINT)
            raise SystemExit(AUTH_HINT) from e
        body = e.read()
        try:
            return e.code, json.loads(body)
        except ValueError:
            return e.code, {"detail": {"error": body[:200].decode("utf-8", "replace")}}


_ENTRIES: dict | None = None


def installed_symbols() -> dict:
    """Every installed symbol entry by name. Read once — the library is 1.3 MB."""
    global _ENTRIES
    if _ENTRIES is None:
        _ENTRIES = dict(split_symbols(SYM_LIB.read_text(encoding="utf-8"))) \
            if SYM_LIB.is_file() else {}
    return _ENTRIES


def to_platform_symbol_entry(name: str) -> str:
    """One installed symbol entry, in the spelling the platform stores.

    Undoes the packager's nickname rewrite: it turns `"7Sigma:` into
    `"PCM_7Sigma:` so footprint refs resolve against the installed library.
    The platform stores the `7Sigma:` form, so a push must put it back or the
    proposal would flip every footprint reference in the symbol.
    """
    return installed_symbols()[name].replace('"PCM_7Sigma:', '"7Sigma:')


def to_platform_symbol(name: str) -> str:
    """That entry wrapped as the .kicad_sym library the platform accepts."""
    return (
        '(kicad_symbol_lib\n\t(version 20251024)\n\t(generator "kicad_symbol_editor")\n'
        '\t(generator_version "10.0")\n' + to_platform_symbol_entry(name) + "\n)\n"
    )


def to_platform_text(text: str) -> str:
    """Undo the packager's 3D-model path rewrite.

    `pcm.py` turns `${SEVENSIGMA_DIR}/3DModels/` into
    `${KICAD10_3RD_PARTY}/3dmodels/com_sevensigma_models3d/` when it builds the
    package, because that is where the models install. The platform validator
    only accepts the `${SEVENSIGMA_DIR}` form, so a push MUST put it back or
    every footprint carrying a model is refused. The variable name is matched
    loosely — it is version-stamped (KICAD10_…) and will change with KiCad.
    """
    return re.sub(r"\$\{[A-Z0-9_]+\}/3dmodels/" + re.escape(MODELS_INSTALL_DIR) + "/",
                  "${SEVENSIGMA_DIR}/3DModels/", text)


def _load_state() -> dict:
    if LOCAL_STATE_FILE.exists():
        try:
            return json.loads(LOCAL_STATE_FILE.read_text())
        except ValueError:
            pass
    return {}


def _save_state(state: dict) -> None:
    """Write the baseline back atomically — Sync writes this file too."""
    tmp = LOCAL_STATE_FILE.with_suffix(".json.part")
    tmp.write_text(json.dumps(state, indent=0))
    tmp.replace(LOCAL_STATE_FILE)


def _changed(baseline: dict) -> list[tuple[str, str, Path, bool]]:
    """Items edited on this machine: (kind, name, path, is_new).

    The baseline is what SYNC WROTE (`local_state.json`), never the mirror
    manifest — the installed bytes legitimately differ from the mirror because
    of the model-path rewrite above, so a manifest diff calls all 155
    model-carrying footprints "edited". Comparing against our own record is
    exact and survives any future transformation.

    The comparison is CANONICAL (`kicad_canon.matches`): KiCad rewrites the
    whole file it saves, in its own spelling, so a byte comparison reported
    every symbol in the library as edited after a single edit.

    A MISSING record means "unknown", never "unchanged", and unknown items are
    FLAGGED. Sync deliberately withholds a record for an entry it kept back
    (`_record_written(..., skip=…)`), so the very drawings this button exists
    to send are the ones with no baseline: an edit made before the first sync
    that protected it never got one, and no later sync writes one either.
    BTS723GW sat unpushable for exactly that reason — Push reported "no local
    changes" over a moved pin (2026-08-21). `_drop_settled` then decides every
    flagged item against the live mirror: same drawing, record a baseline and
    drop it; different drawing, offer it. That costs one request per unknown
    footprint and one for the whole symbol library, so a machine with no state
    file pays ~200 small requests once and ends up with a correct baseline.
    """
    upstream_names = {
        e["path"].split("/")[-1]
        for e in _get_json(f"{BASE_URL}/files/manifest.json")["files"]
        if e["path"].startswith(f"Footprints/{PRETTY}/")
    }
    out = []
    for f in sorted(LOCAL_DIR.glob("*.kicad_mod")):
        rec = baseline.get(str(f))
        if rec is None and f.name not in upstream_names:
            out.append(("footprint", f.stem, f, True))  # not in the library — a creation
        elif not matches(rec, f.read_bytes()):
            out.append(("footprint", f.stem, f, False))

    # symbols all live in ONE generated library file, so the unit of change is
    # an entry inside it, not the file — diff per entry against the baseline
    if SYM_LIB.is_file():
        for name, entry in installed_symbols().items():
            if not matches(baseline.get(f"{SYM_LIB}::{name}"), entry):
                out.append(("symbol", name, SYM_LIB, False))
    return out


def _drop_settled(changed: list, baseline: dict) -> tuple[list, list[str]]:
    """Drop the flagged items whose drawing already IS the platform's current one.

    A stale baseline is not hypothetical. Before plugin 1.1.0 a sync that
    refused to overwrite a local edit never re-recorded it, so a footprint that
    had been pushed, approved and synced stayed flagged for ever and this
    dialog kept offering to propose it again — reported 2026-08-20, five
    footprints. Checking the FLAGGED items (only those) against the live mirror
    costs one request each, corrects the baseline, and makes the whole
    bookkeeping self-healing. It is also where an item with NO baseline gets
    one: `_changed` flags those rather than hiding them, and this is what tells
    an unrecorded local edit from an unrecorded untouched file. A fetch that fails leaves the item flagged:
    offering an edit twice is annoying, losing one is not recoverable.
    """
    still, settled, upstream_syms = [], [], None
    for item in changed:
        kind, name, path, is_new = item
        if is_new:
            still.append(item)  # nothing upstream to compare against
            continue
        try:
            if kind == "symbol":
                if upstream_syms is None:
                    upstream_syms = dict(split_symbols(
                        _get_text(f"{BASE_URL}/files/Symbols/{SYM_FILE}")))
                theirs = upstream_syms.get(name)
                mine = to_platform_symbol_entry(name)
                current = installed_symbols()[name]  # PCM_ spelling, as sync wrote it
                key = f"{SYM_LIB}::{name}"
            else:
                quoted = urllib.parse.quote(f"{name}.kicad_mod")
                theirs = _get_text(f"{BASE_URL}/files/Footprints/{PRETTY}/{quoted}")
                current = path.read_text(encoding="utf-8")
                mine = to_platform_text(current)
                key = str(path)
        except Exception:
            still.append(item)
            continue
        if theirs is not None and canon_hash(mine) == canon_hash(theirs):
            baseline[key] = record(current)  # record it AS INSTALLED, like sync does
            settled.append(name)
        else:
            still.append(item)
    return still, settled


def main() -> int:
    if not LOCAL_DIR.is_dir():
        _notify(f"No local 7Sigma library at {LOCAL_DIR} — run Sync first.")
        return 1
    baseline = _load_state()
    try:
        changed = _changed(baseline)
        changed, settled = _drop_settled(changed, baseline)
    except Exception as e:
        _notify(f"Push failed: cannot reach the platform — {e}")
        return 1
    if settled:
        _save_state(baseline)
    if not changed:
        msg = "No local changes — every footprint and symbol matches the platform."
        if settled:
            msg += f" ({len(settled)} were already approved and are now cleared.)"
        _notify(msg)
        return 0

    labels = [f"{name}  [{kind}]{'  (new)' if is_new else ''}"
              for kind, name, _, is_new in changed]
    picked = _confirm(labels)
    if not picked:
        _notify("Nothing sent.")
        return 0
    comment = _ask_comment(len(picked))
    if comment is None:
        _notify("Nothing sent.")
        return 0

    by_label = {lbl: entry for lbl, entry in zip(labels, changed)}
    try:
        ids = {f["name"]: f["id"] for f in _get_json(f"{BASE_URL}/api/footprints")}
        sym_ids = {s["name"]: s["id"] for s in _get_json(f"{BASE_URL}/api/symbols")}
    except Exception as e:
        _notify(f"Push failed: cannot list the library — {e}")
        return 1

    filed, failed = [], []
    for lbl in picked:
        entry = by_label.get(lbl)
        if entry is None:
            continue
        kind, name, path, _ = entry
        if kind == "symbol":
            sid = sym_ids.get(name)
            if sid is None:
                failed.append(f"{name}: no such symbol on the platform")
                continue
            status, res = _post_json(f"{BASE_URL}/api/symbols/{sid}/propose",
                                     {"source_text": to_platform_symbol(name),
                                      "comment": comment})
        else:
            text = to_platform_text(path.read_text(encoding="utf-8"))
            fid = ids.get(name)
            if fid is None:  # not in the library yet — a creation proposal
                status, res = _post_json(f"{BASE_URL}/api/footprints/propose",
                                         {"source_text": text, "comment": comment, "name": name})
            else:
                status, res = _post_json(f"{BASE_URL}/api/footprints/{fid}/propose",
                                         {"source_text": text, "comment": comment})
        if status == 200 and res.get("ok"):
            filed.append(f"{name} v{res['version_no']}")
        else:
            failed.append(f"{name}: {(res.get('detail') or res).get('error', status)}")

    if filed:
        _notify(f"Proposed {len(filed)}: {', '.join(filed)}. Approve them in the Proposals view.")
    if failed:
        _notify("Push errors: " + "; ".join(failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
